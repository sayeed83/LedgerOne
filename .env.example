# LedgerOne — Environment Variable Documentation
#
# This file documents every variable name the application reads and a
# placeholder/description for each — per 09_SECURITY_GUIDELINES.md (ENV-004).
# It is NEVER a place a real secret value is written, even temporarily.
# Real values are injected via AWS Secrets Manager / ECS task definitions
# in deployed environments (10_DEPLOYMENT_ARCHITECTURE.md), and via a local,
# git-ignored `.env` file in development.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
API_PORT=4000
API_BASE_PATH=/api/v1

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Rate limiting (09_SECURITY_GUIDELINES.md)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# Database — MySQL 8 via Prisma (06_DATABASE_STANDARDS.md)
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://user:password@localhost:3306/ledgerone

# ---------------------------------------------------------------------------
# Cache / Queue — Redis, BullMQ
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication — JWT (RS256) + Refresh Token, Passport.js, Argon2
# (ADR-001: RS256 asymmetric signing, never a shared HS256 secret. These
# keys cover the Tenant End User plane built by the Authentication module;
# the Platform Operator plane (03_ARCHITECTURE.md Ch.9.6) uses its own,
# separate keypair, introduced when that realm is implemented — never these.)
# ---------------------------------------------------------------------------
JWT_PRIVATE_KEY=changeme-jwt-private-key-pem
JWT_PUBLIC_KEY=changeme-jwt-public-key-pem
REFRESH_TOKEN_PRIVATE_KEY=changeme-refresh-token-private-key-pem
REFRESH_TOKEN_PUBLIC_KEY=changeme-refresh-token-public-key-pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# MFA — TOTP via Speakeasy (ADR-002)
MFA_TOTP_ISSUER=LedgerOne

# ---------------------------------------------------------------------------
# AWS — S3 (storage), SES (email), CloudWatch (monitoring)
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_S3_BUCKET=ledgerone-dev
AWS_SES_FROM_EMAIL=no-reply@example.com

# ---------------------------------------------------------------------------
# Web (apps/web) — Next.js public runtime config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
