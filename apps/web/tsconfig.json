{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ledgerone/shared-types": ["../../packages/shared-types/src"],
      "@ledgerone/shared-types/*": ["../../packages/shared-types/src/*"],
      "@ledgerone/shared-utils": ["../../packages/shared-utils/src"],
      "@ledgerone/shared-utils/*": ["../../packages/shared-utils/src/*"],
      "@ledgerone/ui": ["../../packages/ui/src"],
      "@ledgerone/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
