// Accounting module — Prisma schema.
// Standards: 06_DATABASE_STANDARDS.md (Ch.2 Naming/Standard Columns, Ch.3 Primary
// Keys, Ch.4 Foreign Keys, Ch.5 Indexing, Ch.6 Multi-Tenant Isolation, Ch.8 Soft
// Delete). Business rules: 00_BUSINESS_RULES.md Ch.5 (Financial Year), Ch.6
// (Fiscal Period), Ch.7 (Currency), Ch.31 (Exchange Rate).
//
// Module ownership: this module owns Financial Year (the annual reporting-cycle
// definition, Ch.5), Fiscal Period (the monthly-typical subdivision of a
// Financial Year, Ch.6), Currency (Ch.7), Exchange Rate (Ch.31), Tax Group
// (Ch.67), Tax Rule (Ch.68), Account Group (Ch.18), and Account (Ch.17) —
// Database + Repository milestone for Account Group/Account. Financial
// Closing (Ch.32) and Journal Entries (Ch.19-20) are distinct
// entities/chapters and are explicitly not part of this schema yet.
//
// Chart of Accounts (Ch.17): NO separate `ChartOfAccounts` table is modeled.
// Ch.17.10's `COMPANY ||--|| CHART_OF_ACCOUNTS : "owns one"` describes a
// conceptual one-per-Company grouping, not a persisted entity with its own
// attributes — Ch.17.3's "Owns:" list (the hierarchical list of accounts,
// each account's type, normal balance, active/inactive status) describes
// exactly `Account`'s own fields, and no chapter ever assigns
// "Chart of Accounts" itself an independent field, rule, or lifecycle
// distinct from Account's. A Company's Chart of Accounts is simply the set
// of its own `Account` rows (`WHERE company_uuid = ?`), mirroring how
// Ch.66's GST/Ch.69's Reverse Charge/Ch.70's Input Tax Credit were likewise
// not modeled as tables in the Tax milestone for the identical reason —
// flagged as a Handbook Deviation (documented in the milestone report), not
// a guess.
//
// Posting vs. Summary Accounts: `Account.isPostingAccount` is a frozen
// architectural decision (not literal Ch.17 text — the handbook's own
// architecture-review chapter identified this distinction as undefined and
// flagged it for a decision before implementation) — "Only Posting Accounts
// may receive Journal Entry postings; Summary Accounts exist only for
// hierarchy and reporting." Enforcing that restriction at Journal Entry
// posting time is a future Journal Entries module's Business-layer concern
// (Ch.20) — this milestone only persists the flag.
//
// Contra Accounts and Control Accounts are explicitly OUT OF SCOPE per
// frozen architectural decision — no flag, sub-type, or reconciliation
// behavior is modeled for either, mirroring how Tax Rule's jurisdiction
// variation was left unmodeled rather than guessed.
//
// Tax (Part 8, Ch.66-70): only Tax Group (Ch.67) and Tax Rule (Ch.68) are
// modeled as tables — GST (Ch.66.5: "not an entity with its own lifecycle"),
// Reverse Charge (Ch.69.5: "not an independent entity — a calculation/
// posting behavior applied to specific qualifying Purchase Invoices"), and
// Input Tax Credit (Ch.70.5: "not an independent entity — a determination
// and tracking mechanism applied to Purchase Invoice tax amounts") are all
// explicitly documented as behaviors/calculations, not entities with their
// own persisted lifecycle — inventing tables for them would contradict the
// handbook's own scope statements, so they are deliberately not modeled
// here (flagged as a Handbook Deviation in the milestone report, not a
// guess).
//
// Tax Rule's jurisdiction-variation (Ch.68.3/68.10 — "potentially varying by
// jurisdiction (Business Location, Ch.9)") is deliberately NOT modeled as a
// `businessLocationUuid` reference: Business Location (Ch.9) has no table of
// its own anywhere in the codebase yet (Organization's schema defines only
// Tenant/Company/Branch/Department) — referencing a table that does not
// exist would be inventing a shape the handbook never schemas itself.
// Flagged as a Handbook Deviation rather than guessed.
//
// Tax Rule's "calculation basis" (Ch.68.3) is modeled as a single percentage
// rate only — every worked example (Ch.66.11, Ch.67.11, Ch.68.11) is a
// percentage-of-transaction-amount ("18% of pre-tax amount", "0% for
// exports"); no second basis type (e.g., a fixed-amount tax) is ever
// concretely defined, so no `basis` enum/discriminator column is introduced
// speculatively.
//
// Cross-module references (FK-002): `companyUuid` is a plain indexed column
// with no DB-level foreign key — the canonical Company row lives in
// Organization's schema file (`organization.prisma`), and cross-module FKs are
// forbidden regardless of convenience, mirroring User Management's own
// `companyUuid` reference into Organization.
//
// In-module references (FK-001/FK-003/FK-004): FiscalPeriod.financialYearId
// and ExchangeRate.fromCurrencyId/toCurrencyId are real, RESTRICT FKs — both
// sides of each relationship live in this same module schema file, so the
// cross-module prohibition (FK-002) does not apply, mirroring Organization's
// Branch/Department -> Company in-module FKs.
//
// Currency is platform-owned reference data (00_BUSINESS_RULES.md Ch.7.5 —
// "largely static platform-owned reference data... not created or deleted by
// end users in the ordinary course of business"), mirroring Authorization's
// Permission (MT-005): no `tenant_id`, and `created_by`/`updated_by` are
// omitted per 06_DATABASE_STANDARDS.md Ch.2.3's documented exception for a
// platform reference table with no per-row mutation history to attribute.
// Exchange Rate, by contrast, is tenant-owned (Ch.31.5 — rates are "entered,
// manually or via external feed" by/for a specific tenant's operations, the
// same posture as Financial Year/Fiscal Period), so it carries `tenant_id`
// (MT-001) and full audit attribution.
//
// Deliberately NOT modeled here: a "Company activates Currency" join/
// activation table. Ch.7.8/7.10 describe the relationship ("a transaction's
// Currency must be one explicitly activated for the Company") but no chapter
// names or schemas the join entity itself — inventing one would be guessing
// at a shape the handbook never specifies. Flagged as a Handbook Deviation
// (documented in the milestone report) rather than implemented.
//
// Also NOT modeled: an `isBase`/"base currency" flag on Currency itself —
// CMP-002 places the base-currency fact on Company (`baseCurrency`), not on
// Currency, so Company's ERD attribute is a future Organization-schema
// concern, not this module's.

/// The annual accounting/reporting cycle a Company prepares its statutory
/// financial statements against (00_BUSINESS_RULES.md Ch.5.1). Tenant-owned
/// (MT-001) even though reachable via Company, mirroring the established
/// cross-module pattern (Organization's Branch/Department carrying `tenant_id`
/// directly, User Management's `companyUuid` reference). Database milestone
/// only — no Repository/Business/Presentation layer, and Fiscal Period (Ch.6)
/// generation/closing mechanics are explicitly out of scope for this table.
model FinancialYear {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Financial Year start date (00_BUSINESS_RULES.md Ch.5.1/5.7 FY-001) — inclusive.
  startDate DateTime @db.DateTime(3) @map("start_date")
  /// Financial Year end date (Ch.5.1) — inclusive; must not overlap any other Financial Year for the same Company (Ch.5.8), enforced at the Business layer (a later milestone), not by a DB constraint.
  endDate DateTime @db.DateTime(3) @map("end_date")

  /// Financial Year lifecycle state (00_BUSINESS_RULES.md Ch.5.5): Future, Open, Closing, Closed, Reopened.
  status FinancialYearStatus @default(FUTURE) @map("status")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  fiscalPeriods FiscalPeriod[]

  @@unique([companyUuid, startDate, deletedAt], map: "uq_financial_years_company_start_date_deleted_at")
  @@index([tenantId, companyUuid, status], map: "idx_financial_years_tenant_company_status")
  @@index([companyUuid], map: "idx_financial_years_company_uuid")
  @@map("financial_years")
}

/// Mirrors 00_BUSINESS_RULES.md Ch.5.5 Financial Year lifecycle exactly (05_CODING_STANDARDS.md Ch.26.4).
enum FinancialYearStatus {
  FUTURE
  OPEN
  CLOSING
  CLOSED
  REOPENED

  @@map("financial_year_status")
}

/// Subdivision of a Financial Year (00_BUSINESS_RULES.md Ch.6.1) — the
/// granular unit at which transactions are posted and periods are
/// individually closed. Tenant-owned (MT-001) and carries `companyUuid`
/// directly (cross-module reference, FK-002, no DB-level FK) even though
/// reachable via its parent FinancialYear, mirroring the same
/// reachable-but-still-carried pattern Organization uses for Branch/Department
/// carrying both `tenantId` and `companyId`. `financialYearId` is a real,
/// in-module RESTRICT FK (FK-001/FK-003/FK-004) since both models live in this
/// module. Database milestone only — no Repository/Business/Presentation
/// layer, and period auto-generation/closing mechanics (Ch.6.6, Ch.32) are
/// explicitly out of scope for this table.
model FiscalPeriod {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  financialYearId BigInt        @db.UnsignedBigInt @map("financial_year_id")
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Fiscal Period start date (00_BUSINESS_RULES.md Ch.6.1) — inclusive.
  startDate DateTime @db.DateTime(3) @map("start_date")
  /// Fiscal Period end date (Ch.6.1) — inclusive; must not overlap any other Fiscal Period within the same Financial Year, enforced at the Business layer (a later milestone), not by a DB constraint.
  endDate DateTime @db.DateTime(3) @map("end_date")

  /// Fiscal Period lifecycle state (00_BUSINESS_RULES.md Ch.6.5): Open, SoftClosed, Closed, Reopened.
  status FiscalPeriodStatus @default(OPEN) @map("status")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@unique([financialYearId, startDate, deletedAt], map: "uq_fiscal_periods_financial_year_start_date_deleted_at")
  @@index([tenantId, companyUuid, status], map: "idx_fiscal_periods_tenant_company_status")
  @@index([companyUuid], map: "idx_fiscal_periods_company_uuid")
  @@index([financialYearId], map: "idx_fiscal_periods_financial_year_id")
  @@map("fiscal_periods")
}

/// Mirrors 00_BUSINESS_RULES.md Ch.6.5 Fiscal Period lifecycle exactly (05_CODING_STANDARDS.md Ch.26.4).
enum FiscalPeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
  REOPENED

  @@map("fiscal_period_status")
}

/// A unit of monetary value LedgerOne supports for transactions/reporting
/// (00_BUSINESS_RULES.md Ch.7.1) — ISO code, symbol, and decimal-precision
/// convention (Ch.7.3, CUR-003). Platform-owned reference data (Ch.7.5,
/// mirrors Authorization's Permission/MT-005): no `tenant_id`, no
/// `created_by`/`updated_by` (06_DATABASE_STANDARDS.md Ch.2.3 documented
/// exception). `isoCode` is unique with no `deletedAt` composite (unlike
/// FinancialYear/FiscalPeriod's date-range uniques) — an ISO 4217 code is
/// never intended to be reissued to a different Currency row after a
/// deactivation, a deliberate never-reuse decision (06_DATABASE_STANDARDS.md
/// SD-004 exception), documented here rather than assumed. Database +
/// Repository milestone only — Company-Currency activation (Ch.7.8/7.10) is
/// explicitly not modeled (see file header) and Business-layer validation
/// (CUR-001/002/003) is a later milestone.
model Currency {
  id   BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid String @unique @db.Char(36) @map("uuid")

  /// ISO 4217 currency code (e.g. USD, EUR, INR) — 00_BUSINESS_RULES.md Ch.7.3.
  isoCode String @unique @db.VarChar(3) @map("iso_code")
  /// Full currency name (e.g. "US Dollar") — Ch.7.3.
  name String @db.VarChar(100) @map("name")
  /// Display symbol (e.g. "$", "€") — Ch.7.3.
  symbol String @db.VarChar(10) @map("symbol")
  /// Decimal precision convention for amounts in this currency (Ch.7.3/CUR-003) — e.g. 2 for USD, 0 for JPY.
  decimalPrecision Int @db.UnsignedTinyInt @map("decimal_precision")

  /// Currency lifecycle state — Active/Inactive (00_BUSINESS_RULES.md Ch.31.8 references "Active currencies"; an Inactive Currency cannot be selected on a transaction, Ch.7.8, or referenced by a new Exchange Rate, Ch.31.8).
  status CurrencyStatus @default(ACTIVE) @map("status")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  exchangeRatesFrom ExchangeRate[] @relation("ExchangeRateFromCurrency")
  exchangeRatesTo   ExchangeRate[] @relation("ExchangeRateToCurrency")

  @@index([status], map: "idx_currencies_status")
  @@map("currencies")
}

/// Mirrors 00_BUSINESS_RULES.md Ch.7.5/7.8 Currency lifecycle (05_CODING_STANDARDS.md Ch.26.4).
enum CurrencyStatus {
  ACTIVE
  INACTIVE

  @@map("currency_status")
}

/// The defined conversion factor between two Currencies as of a specific
/// date (00_BUSINESS_RULES.md Ch.31.1) — currency pair, rate value, and
/// effective date (Ch.31.3). Tenant-owned (MT-001) — rates are entered per
/// Ch.31.5 for a tenant's own operations, mirroring Financial Year/Fiscal
/// Period's tenant ownership rather than Currency's platform ownership.
/// `fromCurrencyId`/`toCurrencyId` are real, in-module RESTRICT FKs
/// (FK-001/FK-003/FK-004) to Currency.id, since both models live in this same
/// schema file. Forms a historical, immutable time series (Ch.31.5, EXR-002)
/// — no update/remove method is provided at the Repository layer (see
/// interface); a correction is a new, dated rate row, a Business-layer
/// concern for a later milestone. Database + Repository milestone only —
/// EXR-001's "most recently effective prior rate" lookup (Ch.31.12) and
/// EXR-002's post-transaction immutability enforcement are explicitly
/// Business-layer concerns, not implemented here.
model ExchangeRate {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  fromCurrencyId BigInt   @db.UnsignedBigInt @map("from_currency_id")
  fromCurrency   Currency @relation("ExchangeRateFromCurrency", fields: [fromCurrencyId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  toCurrencyId BigInt   @db.UnsignedBigInt @map("to_currency_id")
  toCurrency   Currency @relation("ExchangeRateToCurrency", fields: [toCurrencyId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Conversion factor, from -> to (00_BUSINESS_RULES.md Ch.31.3/31.8 — must be positive; enforced at the Business layer, not a DB constraint). DECIMAL(20,10): no handbook-documented precision/scale exists for rate values (flagged as a Handbook Deviation, decided inline) — wider than a monetary-amount DECIMAL since a rate is a ratio, not a currency-precision amount (Ch.7.3/CUR-003 governs amounts, not rates).
  rate Decimal @db.Decimal(20, 10) @map("rate")
  /// The date this rate is effective as-of (00_BUSINESS_RULES.md Ch.31.1/31.7 EXR-001).
  effectiveDate DateTime @db.DateTime(3) @map("effective_date")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@unique([tenantId, fromCurrencyId, toCurrencyId, effectiveDate, deletedAt], map: "uq_exchange_rates_tenant_pair_effective_date_deleted_at")
  @@index([tenantId, fromCurrencyId, toCurrencyId], map: "idx_exchange_rates_tenant_pair")
  @@index([fromCurrencyId], map: "idx_exchange_rates_from_currency_id")
  @@index([toCurrencyId], map: "idx_exchange_rates_to_currency_id")
  @@map("exchange_rates")
}

/// A named tax classification applied to Products/Product Categories
/// (00_BUSINESS_RULES.md Ch.67.1), determining which Tax Rule (Ch.68)
/// applies to a transaction. Tenant-owned (MT-001) and carries `companyUuid`
/// directly (cross-module reference, FK-002, no DB-level FK) — Ch.67.13's
/// "Finance Manager or Company Administrator approval" requirement implies
/// Company-level configuration, mirroring Financial Year's own
/// tenant+companyUuid ownership rather than Currency's platform ownership.
/// No lifecycle/status column: Ch.67.5 documents Tax Group as "static,
/// low-change reference data" with no state machine, unlike
/// FinancialYear/FiscalPeriod/Currency — `deletedAt` (soft delete, Ch.8) is
/// the only lifecycle signal this table carries. Database + Repository
/// milestone only — TXG-001's "every taxable Product resolves to exactly
/// one Tax Group" and TXG-002's jurisdiction variation are Business-layer/
/// other-module concerns, not implemented here.
model TaxGroup {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Tax Group name (00_BUSINESS_RULES.md Ch.67.1, e.g. "Standard Rate", "Zero Rate", "Exempt").
  name String @db.VarChar(100) @map("name")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  taxRules TaxRule[]

  /// Partial duplicate-name protection per Company (06_DATABASE_STANDARDS.md SD-004 pattern) — not explicit handbook text, a documented Handbook Deviation mirroring FinancialYear's own `uq_financial_years_company_start_date_deleted_at` reasoning.
  @@unique([tenantId, companyUuid, name, deletedAt], map: "uq_tax_groups_tenant_company_name_deleted_at")
  @@index([tenantId, companyUuid], map: "idx_tax_groups_tenant_company")
  @@index([companyUuid], map: "idx_tax_groups_company_uuid")
  @@map("tax_groups")
}

/// The specific calculation logic (rate, effective date range) a Tax Group
/// (Ch.67) maps to (00_BUSINESS_RULES.md Ch.68.1). Tenant-owned (MT-001) —
/// mirrors its parent Tax Group's ownership. `taxGroupId` is a real,
/// in-module RESTRICT FK (FK-001/FK-003/FK-004) since both models live in
/// this same schema file. Versioned by effective date (Ch.68.5, "similar to
/// Price Lists") and immutable once created (TXR-003 — "a rate correction
/// requires a new, dated rule", mirroring ExchangeRate's own
/// Ch.31.5/EXR-002 immutability) — no update/remove Repository method is
/// provided. `rate` is `DECIMAL(9,4)` — no handbook-documented
/// precision/scale exists for a tax percentage (flagged as a Handbook
/// Deviation, decided inline, mirroring ExchangeRate.rate's own documented
/// precision deviation), sized for a percentage value (up to 99999.9999)
/// rather than ExchangeRate's wider ratio-oriented DECIMAL(20,10). Database
/// + Repository milestone only — TXR-001's non-overlap validation and
/// TXR-002's date-of-transaction resolution are explicitly Business-layer
/// concerns (mirroring FinancialYear/FiscalPeriod's own deferred overlap
/// validation), not implemented here.
model TaxRule {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  taxGroupId BigInt   @db.UnsignedBigInt @map("tax_group_id")
  taxGroup   TaxGroup @relation(fields: [taxGroupId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Tax percentage rate (00_BUSINESS_RULES.md Ch.68.1/68.11, e.g. 18.0000 for "18% of pre-tax transaction amount").
  rate Decimal @db.Decimal(9, 4) @map("rate")
  /// Effective date range start (00_BUSINESS_RULES.md Ch.68.3/68.7 TXR-001) — inclusive.
  effectiveFrom DateTime @db.DateTime(3) @map("effective_from")
  /// Effective date range end (Ch.68.7 TXR-001) — inclusive; null means open-ended (still in effect, not yet superseded by a later-dated rule for the same Tax Group).
  effectiveTo DateTime? @db.DateTime(3) @map("effective_to")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  /// Partial duplicate-start-date protection per Tax Group (SD-004 pattern), mirroring FiscalPeriod's own `uq_fiscal_periods_financial_year_start_date_deleted_at` reasoning — true overlap validation (TXR-001) is a Business-layer concern.
  @@unique([taxGroupId, effectiveFrom, deletedAt], map: "uq_tax_rules_tax_group_effective_from_deleted_at")
  @@index([tenantId, taxGroupId], map: "idx_tax_rules_tenant_tax_group")
  @@index([taxGroupId], map: "idx_tax_rules_tax_group_id")
  @@map("tax_rules")
}

/// The five fundamental account classifications (00_BUSINESS_RULES.md
/// Ch.16 DBL-003/Ch.17.7 COA-001) — shared by both `AccountGroup` (Ch.18
/// AGP-002 — a group's type must match every account assigned to it) and
/// `Account` itself. Determines normal balance (Ch.16 DBL-003: Asset/Expense
/// increase on Debit, Liability/Equity/Revenue increase on Credit) — normal
/// balance is deliberately NOT a separate stored column, since it is a pure,
/// universal function of `accountType` with no per-row variation; storing it
/// independently would duplicate the same fact and risk drift.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("account_type")
}

/// A classification category organizing Accounts (Ch.17) into reporting
/// groupings (00_BUSINESS_RULES.md Ch.18.1, e.g. "Current Assets", "Fixed
/// Assets"). Tenant-owned (MT-001) and carries `companyUuid` directly
/// (cross-module reference, FK-002, no DB-level FK), mirroring Tax Group's
/// own tenant+companyUuid ownership shape — Ch.18.13's "Company
/// Administrator approval" to modify the hierarchy implies Company-level
/// configuration, not platform-wide reference data. Ch.18.5's "largely
/// static, platform-provided standard groupings, with the option for
/// Company-specific customization" describes a Business-layer seeding
/// workflow (applying a standard template to a new Company), not a
/// database-level platform-vs-tenant ownership split — no separate
/// platform-owned "AccountGroupTemplate" table is modeled, since no chapter
/// schemas one; flagged as a Handbook Deviation rather than invented.
/// `parentAccountGroupId` is a real, in-module, self-referential RESTRICT FK
/// (FK-001/FK-003/FK-004) supporting Ch.18 AGP-003's nesting. AGP-002's
/// type-consistency-with-assigned-accounts and AGP-003's
/// type-consistency-throughout-nesting are Business-layer concerns (cannot
/// be expressed as a MySQL/Prisma declarative constraint across FK-linked
/// rows), not implemented here — mirrors every other cross-row invariant
/// this module has already deferred (FY-002 overlap, TXR-001 overlap).
model AccountGroup {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Account Group name (00_BUSINESS_RULES.md Ch.18.1, e.g. "Current Assets", "Fixed Assets").
  name String @db.VarChar(100) @map("name")

  /// The account type this group classifies (Ch.18.7 AGP-002) — shared enum with `Account.accountType`.
  accountType AccountType @map("account_type")

  /// Self-referential parent for nested groupings (Ch.18.7 AGP-003, e.g. "Current Assets" containing "Cash and Equivalents").
  parentAccountGroupId BigInt?       @db.UnsignedBigInt @map("parent_account_group_id")
  parentAccountGroup   AccountGroup? @relation("AccountGroupHierarchy", fields: [parentAccountGroupId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  childAccountGroups    AccountGroup[] @relation("AccountGroupHierarchy")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  accounts Account[]

  /// Partial duplicate-name protection per Company (SD-004 pattern), mirroring Tax Group's own `uq_tax_groups_tenant_company_name_deleted_at` reasoning — not explicit handbook text.
  @@unique([tenantId, companyUuid, name, deletedAt], map: "uq_account_groups_tenant_company_name_deleted_at")
  @@index([tenantId, companyUuid], map: "idx_account_groups_tenant_company")
  @@index([companyUuid], map: "idx_account_groups_company_uuid")
  @@index([parentAccountGroupId], map: "idx_account_groups_parent_account_group_id")
  @@map("account_groups")
}

/// Mirrors 00_BUSINESS_RULES.md Ch.17.5 Account lifecycle exactly (05_CODING_STANDARDS.md Ch.26.4): Draft (proposed) -> Active (approved, postable) -> Inactive (no new postings, historical retained) -> Active (reactivated).
enum AccountStatus {
  DRAFT
  ACTIVE
  INACTIVE

  @@map("account_status")
}

/// An individual financial account within a Company's Chart of Accounts
/// (00_BUSINESS_RULES.md Ch.17.1) — the classification unit every Journal
/// Entry line will post against (a future Journal Entries module, Ch.20).
/// Tenant-owned (MT-001) and carries `companyUuid` directly (cross-module
/// reference, FK-002, no DB-level FK), mirroring Tax Group's own ownership
/// shape — Ch.17.13's "Company Administrator (or delegated Finance Manager)
/// approval" to create/modify/deactivate an account implies Company-level
/// ownership. `accountGroupId` is a real, in-module RESTRICT FK
/// (FK-001/FK-003/FK-004, Ch.18 AGP-001 — "every account must be assigned to
/// exactly one Account Group") — required, not nullable.
/// `parentAccountId` is a real, in-module, self-referential nullable
/// RESTRICT FK (Ch.17.7 COA-002 — "an account may have a parent account").
/// `code` is unique per Company with NO `deletedAt` composite — Ch.17.7
/// COA-004 explicitly states codes "cannot be reused for a different
/// account, even after deactivation," a deliberate never-reuse rule (unlike
/// every other unique constraint in this module, which is only a
/// documented Handbook Deviation for hygiene — COA-004 is literal handbook
/// text). `isPostingAccount` implements the frozen architectural decision
/// that only Posting Accounts may receive Journal Entry postings, Summary
/// Accounts exist only for hierarchy/reporting — not literal Ch.17 text
/// (flagged as a Handbook Deviation/frozen architectural decision, not
/// guessed); enforcing the restriction at posting time is a future Journal
/// Entries module's Business-layer concern. `accountType`'s immutability
/// once the account has any posted transaction (COA-001) and COA-003's
/// deactivation-blocked-while-non-zero-balance/open-transaction rule are
/// both Business-layer concerns (this milestone has no Ledger/Journal Entry
/// to check against yet) — not implemented here. No separate `normalBalance`
/// column: derived purely from `accountType` (Ch.16 DBL-003), never stored
/// independently.
model Account {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Account code, unique per Company, never reused (Ch.17.7 COA-004) — e.g. "1000", "1200". VARCHAR(20) width inferred (no handbook-specified length), flagged inline rather than assumed silently.
  code String @db.VarChar(20) @map("code")
  /// Account name (00_BUSINESS_RULES.md Ch.17.8 — required, descriptive enough for unambiguous selection during transaction entry).
  name String @db.VarChar(150) @map("name")

  /// The account's fundamental type (Ch.17.7 COA-001) — shared enum with `AccountGroup.accountType`.
  accountType AccountType @map("account_type")

  accountGroupId BigInt       @db.UnsignedBigInt @map("account_group_id")
  accountGroup   AccountGroup @relation(fields: [accountGroupId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Self-referential parent for account hierarchy (Ch.17.7 COA-002).
  parentAccountId BigInt?  @db.UnsignedBigInt @map("parent_account_id")
  parentAccount   Account? @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  childAccounts   Account[] @relation("AccountHierarchy")

  /// Frozen architectural decision: true = Posting Account (may receive Journal Entry postings); false = Summary Account (hierarchy/reporting only, no direct postings) — not literal Ch.17 text, see model-level doc comment.
  isPostingAccount Boolean @default(true) @map("is_posting_account")

  /// Account lifecycle (00_BUSINESS_RULES.md Ch.17.5): Draft/Active/Inactive.
  status AccountStatus @default(DRAFT) @map("status")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  /// Never-reuse per Company (Ch.17.7 COA-004) — deliberately no `deletedAt` in this composite, unlike every other unique constraint in this module.
  @@unique([tenantId, companyUuid, code], map: "uq_accounts_tenant_company_code")
  @@index([tenantId, companyUuid, status], map: "idx_accounts_tenant_company_status")
  @@index([companyUuid], map: "idx_accounts_company_uuid")
  @@index([accountGroupId], map: "idx_accounts_account_group_id")
  @@index([parentAccountId], map: "idx_accounts_parent_account_id")
  @@map("accounts")
}
