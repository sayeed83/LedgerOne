// Inventory module — Prisma schema.
// Standards: 06_DATABASE_STANDARDS.md (Ch.2 Naming/Standard Columns, Ch.3 Primary
// Keys, Ch.4 Foreign Keys, Ch.5 Indexing, Ch.6 Multi-Tenant Isolation, Ch.8 Soft
// Delete). Business rules: 00_BUSINESS_RULES.md Ch.34 (Products), Ch.35 (Product
// Categories), Ch.36 (Units), Ch.37 (Warehouses), Ch.38 (Stock), Ch.39 (Stock
// Movement), Ch.40 (Batch), Ch.41 (Serial Numbers), Ch.42 (Reorder Levels),
// Ch.43 (Stock Valuation), Ch.44 (Inventory Adjustment).
//
// Module ownership: this module owns Product Category (Ch.35), Unit (Ch.36),
// Product (Ch.34), Warehouse (Ch.37), Stock (Ch.38), Stock Movement (Ch.39),
// Batch (Ch.40), Serial Number (Ch.41), Reorder Level (Ch.42), Stock
// Valuation (Ch.43), and Inventory Adjustment (Ch.44).
//
// Milestone history: Product Category (Ch.35) and Unit (Ch.36) were each
// carried through their own Database milestones and are complete (see
// engineering/implementation/current-phase.md) — not modified by this
// milestone. This milestone adds Product (Ch.34) — Database layer ONLY, per
// explicit instruction, mirroring how Product Category's/Unit's own first
// milestones started (single entity, single layer, then stop). A later
// revision added Warehouse (Ch.37) — Database layer ONLY, same
// single-entity, single-layer, then-stop pattern. This revision adds Stock
// (Ch.38) — Database layer ONLY, the current on-hand-inventory snapshot per
// Product per Warehouse; Stock Movement (Ch.39) and every later chapter in
// this module remain unstarted; no table is modeled for any of them yet.
// Repository/Business/Presentation/Integration/Frontend layers for Product,
// Warehouse, and Stock are also not started — stop condition for this
// milestone.
//
// `productCategoryId` and `unitId` are real, in-module RESTRICT foreign keys
// (FK-001) — NOT the uuid-reference pattern (FK-002), because Product
// Category and Unit are both owned by this same Inventory module, unlike
// `companyUuid` (a genuine cross-module reference into Organization). This
// mirrors ProductCategory's own self-referential FK and Unit's own
// `baseUnitId` FK, both real in-module FKs targeting `id`.
//
// `unitId` is nullable: 00_BUSINESS_RULES.md Ch.34.8 requires a Unit of
// Measure only for a Stocked Product ("a Stocked Product must specify a Unit
// of Measure") — a Non-Stocked (service) Product has none. Enforcing "must
// be set when isStocked is true" is a Business-layer concern (a later
// milestone), not a DB CHECK constraint, mirroring Unit's own nullable
// `conversionFactor` (required only when `baseUnitId` is set) reasoning.
//
// `productCode` (PRD-001, "unique identifying code within the Company") is
// unique per Company with `deletedAt` in the constraint (06_DATABASE_
// STANDARDS.md SD-004) — reusable after soft delete, mirroring Organization's
// own `companyCode`/`branchCode`/`departmentCode` pattern; no handbook rule
// forbids reuse the way COA-003/004 does for Chart of Accounts codes.
//
// `status` (ProductStatus: Draft/Active/Discontinued) models Ch.34.5's
// documented lifecycle state diagram exactly, mirroring Role's own
// `RoleStatus` enum pattern (05_CODING_STANDARDS.md Ch.26.4). PRD-003 ("a
// Product cannot be Discontinued while it has non-zero Stock on hand") and
// Ch.34.12's "Stocked classification is fixed once transacted" are both
// Business-layer validations (later milestones, depend on Stock/Ch.38 which
// doesn't exist yet) — not enforced at this layer.
//
// Product Category is tenant-owned (`tenant_id`, MT-001) with `companyUuid`
// as a cross-module reference (FK-002) to Organization's `companies.uuid` —
// no DB-level FK, mirroring Financial Year's/Account Group's own
// `companyUuid` pattern. This matches Ch.34.9 ("[Product] Depends on:
// Company") — Products, and therefore the Categories that classify them, are
// scoped per Company, consistent with Ch.2.16's "Inventory ... is tracked
// per Company."
//
// `parentProductCategoryId` is a real, in-module RESTRICT self-referential FK
// (Ch.35.10's ERD: "PRODUCT_CATEGORY ||--o{ PRODUCT_CATEGORY : may have
// sub-categories"), mirroring Account Group's own self-referential hierarchy
// (Ch.18.7 AGP-003).
//
// `defaultTaxGroupUuid` is a cross-module reference (FK-002, no DB-level FK)
// to Accounting's `tax_groups.uuid` (Ch.67) — the category-level default Tax
// Group Ch.35.3/PCT-002 describes ("Category-level defaults... apply to a
// Product only if the Product does not explicitly override them").
//
// Handbook Deviation (flagged, not guessed): Ch.35.3 also names a
// category-level "default Unit of Measure" — NOT modeled here, since Unit
// (Ch.36) has no table yet in this codebase; adding a column referencing a
// nonexistent entity would be invention. To be added once Unit has its own
// Database milestone, mirroring how Journal Entry's Voucher/Cost Center
// references were deferred for the same reason.
//
// `name` uniqueness "within its hierarchy level" (Ch.35.8) is only partially
// enforced by `uq_product_categories_company_parent_name_deleted_at` below —
// MySQL's unique index treats every NULL `parent_product_category_id` as
// distinct, so two top-level (root) Categories under the same Company could
// still share a name without violating this constraint. True sibling-name
// uniqueness (including at the root level) is deferred to a later
// Business-layer milestone, mirroring how Financial Year's own overlap
// validation was only partially DB-protected and finished at the Business
// layer.
model ProductCategory {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Product Category name (00_BUSINESS_RULES.md Ch.35.1) — intended to be unique within its hierarchy level (Ch.35.8); see the file-level Handbook Deviation note on the partial DB constraint below.
  name String @db.VarChar(100) @map("name")

  /// Self-referential parent for nested Categories (Ch.35.1/35.10 "may have sub-categories").
  parentProductCategoryId BigInt?           @db.UnsignedBigInt @map("parent_product_category_id")
  parentProductCategory   ProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentProductCategoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  childProductCategories  ProductCategory[] @relation("ProductCategoryHierarchy")

  /// Back-relation for Product's real, in-module RESTRICT FK (Ch.34.9) — this milestone's Database layer only, no repository/service reads this relation yet.
  products Product[]

  /// Cross-module reference to Accounting's `tax_groups.uuid` (Ch.67) — category-level default Tax Group (Ch.35.3/PCT-002), FK-002, no DB-level FK. A Product may override this (Ch.35.12).
  defaultTaxGroupUuid String? @db.Char(36) @map("default_tax_group_uuid")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@unique([companyUuid, parentProductCategoryId, name, deletedAt], map: "uq_product_categories_company_parent_name_deleted_at")
  @@index([tenantId, companyUuid], map: "idx_product_categories_tenant_company")
  @@index([companyUuid, parentProductCategoryId], map: "idx_product_categories_company_parent")
  @@map("product_categories")
}

// Unit of Measure (00_BUSINESS_RULES.md Ch.36: quantity-measurement
// convention for a Product, Ch.34 — e.g. Pieces, Kilograms, Liters, Boxes —
// including conversion factors between related units). Tenant-owned
// (`tenant_id`, MT-001) with `companyUuid` as a cross-module reference
// (FK-002) to Organization's `companies.uuid` — no DB-level FK, mirroring
// Product Category's/Account Group's own `companyUuid` pattern.
//
// Ch.36.5 describes Units as "largely platform-provided" reference data
// "with Company-specific custom units as needed" — the identical
// platform-template-vs-Company-instance ambiguity Account Group's own
// Ch.18.5 raised (that milestone's own carried-forward open design
// question, per `engineering/implementation/current-phase.md`). Resolved
// here the same way: a plain tenant/company-owned table, not a nullable-
// tenant platform/tenant hybrid schema — the platform-template seeding
// workflow remains an explicitly deferred, not-yet-designed mechanism
// (likely a future seed script populating each Company's own rows), not a
// schema-level distinction this milestone invents.
//
// `baseUnitId` is a real, in-module RESTRICT self-referential FK — Ch.36.1/
// 36.3's "conversion factor to a defined base unit where applicable" and
// Ch.36.11's worked example (a "Box of 100" alternate Unit pointing to a
// "Pieces" base Unit). `null` on a Unit row means that row IS a base unit
// itself (Ch.36.7 UNT-001's "exactly one base Unit" per Stocked Product is
// therefore expressed as the Product's own future `baseUnitId` reference,
// a Ch.34/Product-table concern, not modeled here). `conversionFactor` is
// likewise nullable — required only when `baseUnitId` is set; Ch.36.8's
// "must be a positive number" validation is a Business-layer concern (a
// later milestone), not a DB CHECK constraint. `DECIMAL(20,10)` mirrors
// Exchange Rate's own `rate` column precision/scale exactly (a ratio, not
// a currency-precision amount) — no handbook-documented precision/scale
// exists for a conversion factor either, so this is the same flagged
// Handbook Deviation carried forward, not a newly invented one.
model Unit {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Unit name (00_BUSINESS_RULES.md Ch.36.1, e.g. "Pieces", "Kilograms", "Box of 100").
  name String @db.VarChar(100) @map("name")

  /// Short display symbol (Ch.36.3, e.g. "Pcs", "Kg", "L") — no handbook-specified length; VarChar(20) is a reasonable, undocumented choice mirroring other short-string columns in this schema.
  symbol String @db.VarChar(20) @map("symbol")

  /// Self-referential base Unit this row converts to (Ch.36.1/36.3/36.11) — null means this row IS a base Unit.
  baseUnitId BigInt? @db.UnsignedBigInt @map("base_unit_id")
  baseUnit   Unit?   @relation("UnitConversion", fields: [baseUnitId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  alternateUnits Unit[] @relation("UnitConversion")

  /// Back-relation for Product's real, in-module RESTRICT FK (Ch.34.9) — this milestone's Database layer only, no repository/service reads this relation yet.
  products Product[]

  /// Conversion factor to `baseUnit` (Ch.36.1/36.3/36.7 UNT-002, e.g. 100 for "Box of 100" -> "Pieces") — required only when `baseUnitId` is set; positivity (Ch.36.8) is a Business-layer concern.
  conversionFactor Decimal? @db.Decimal(20, 10) @map("conversion_factor")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  /// Partial duplicate-name protection per Company (06_DATABASE_STANDARDS.md SD-004 pattern) — not explicit handbook text, mirroring Tax Group's/Account Group's own identical `uq_..._tenant_company_name_deleted_at` reasoning.
  @@unique([tenantId, companyUuid, name, deletedAt], map: "uq_units_tenant_company_name_deleted_at")
  @@index([tenantId, companyUuid], map: "idx_units_tenant_company")
  @@index([companyUuid], map: "idx_units_company_uuid")
  @@map("units")
}

// Product (00_BUSINESS_RULES.md Ch.34: the master-data record describing an
// item a Company buys, sells, manufactures, or stocks — item name,
// description, Product Category, Unit of Measure, and Stocked/Non-Stocked
// classification). Tenant-owned (`tenant_id`, MT-001) with `companyUuid` as
// a cross-module reference (FK-002) to Organization's `companies.uuid` — no
// DB-level FK, mirroring Product Category's/Unit's own `companyUuid`
// pattern, consistent with Ch.34.9 ("Depends on: Company").
//
// `productCategoryId`/`unitId` are real, in-module RESTRICT foreign keys
// (FK-001), not cross-module uuid references — see the file-level note
// above. `productCategoryId` is required (PCT-001: "Every Product must be
// assigned to exactly one Product Category"); `unitId` is nullable (Ch.34.8:
// required only for a Stocked Product, a Business-layer concern).
//
// `status` (ProductStatus) models Ch.34.5's Draft → Active → Discontinued
// lifecycle; transition validation (e.g. PRD-003) is a Business-layer
// concern, not modeled here.
model Product {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Unique identifying code within the Company (00_BUSINESS_RULES.md Ch.34.7 PRD-001) — reusable after soft delete (06_DATABASE_STANDARDS.md SD-004), mirroring Organization's own `companyCode`/`branchCode`/`departmentCode` pattern.
  productCode String @db.VarChar(32) @map("product_code")

  /// Product name (00_BUSINESS_RULES.md Ch.34.3).
  name String @db.VarChar(150) @map("name")

  /// Free-text item description (Ch.34.3).
  description String? @db.VarChar(500) @map("description")

  /// Real, in-module RESTRICT FK to this module's own Product Category (Ch.35) — required, PCT-001.
  productCategoryId BigInt          @db.UnsignedBigInt @map("product_category_id")
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Real, in-module RESTRICT FK to this module's own Unit (Ch.36) — nullable; required only for a Stocked Product (Ch.34.8), a Business-layer concern.
  unitId BigInt? @db.UnsignedBigInt @map("unit_id")
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Back-relation for Stock's real, in-module RESTRICT FK (Ch.38.9) — this milestone's Database layer only, no repository/service reads this relation yet.
  stocks Stock[]

  /// Stocked (tracked in Inventory) vs. Non-Stocked (e.g. a service) classification, set at creation (Ch.34.7 PRD-002). Immutability once transacted (Ch.34.12) is a Business-layer concern.
  isStocked Boolean @map("is_stocked")

  /// Product lifecycle state (00_BUSINESS_RULES.md Ch.34.5): Draft, Active, Discontinued.
  status ProductStatus @default(DRAFT) @map("status")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@unique([companyUuid, productCode, deletedAt], map: "uq_products_company_product_code_deleted_at")
  @@index([tenantId, companyUuid], map: "idx_products_tenant_company")
  @@index([companyUuid, productCategoryId], map: "idx_products_company_category")
  @@index([tenantId, companyUuid, status], map: "idx_products_tenant_company_status")
  @@map("products")
}

/// Mirrors 00_BUSINESS_RULES.md Ch.34.5 Product lifecycle exactly (05_CODING_STANDARDS.md Ch.26.4).
enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED

  @@map("product_status")
}

// Warehouse (00_BUSINESS_RULES.md Ch.37: a physical stock-keeping location
// within a Branch where Inventory, Ch.38, is physically held). Tenant-owned
// (`tenant_id`, MT-001).
//
// Handbook Deviation (flagged, not guessed): this milestone's own prompt
// asked for a `companyUuid` cross-module reference, mirroring Product
// Category's/Unit's/Product's own `companyUuid` pattern. However,
// WHS-001 ("Every Warehouse belongs to exactly one Branch") and Ch.37.9's
// Dependencies ("Depends on: Branch (Ch.3)") and Ch.37.10's ERD
// (`BRANCH ||--o{ WAREHOUSE : "contains"`) all describe Warehouse as a
// child of Branch, not of Company directly — Company is only reachable
// transitively through Branch (Branch itself owns a real `companyId` FK,
// organization.prisma). Per CLAUDE.md Ch.5/Ch.13/Ch.27 ("the handbook
// wins... never assume a business rule not documented... ask instead"),
// this was raised with the user, who confirmed: model the real WHS-001
// relationship as `branchUuid` (FK-002, cross-module reference to
// Organization's `branches.uuid` — no DB-level FK, since Branch lives in a
// different module, mirroring Product/Unit/ProductCategory's own
// `companyUuid` FK-002 pattern exactly) and drop `companyUuid` entirely,
// since Company is not Warehouse's direct parent.
//
// `warehouseCode` and `name` are each unique per Branch (Ch.37.8: "Warehouse
// name must be unique within its Branch") including `deletedAt` in the
// constraint (06_DATABASE_STANDARDS.md SD-004, reusable after soft delete),
// mirroring Branch's own `branchCode`/`branchName` dual-unique pattern
// (organization.prisma) rather than Product's single combined-code unique.
//
// `status` (WarehouseStatus: Active/Inactive) mirrors Ch.37.5's Business
// Lifecycle exactly, using the same two-value convention as `BranchStatus`
// (organization.prisma) rather than Product's three-value lifecycle.
// WHS-002 ("cannot be deactivated while it holds non-zero Stock") is a
// Business-layer concern (a later milestone, depends on Stock/Ch.38 which
// doesn't exist yet) — not enforced at this layer.
model Warehouse {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `branches.uuid` (FK-002) — no DB-level FK. Warehouse's real parent per WHS-001/Ch.37.9/37.10 (not Company directly — see file-level Handbook Deviation note above).
  branchUuid String @db.Char(36) @map("branch_uuid")

  /// Unique identifying code within the Branch (mirrors Branch's own `branchCode`/Product's `productCode` convention) — reusable after soft delete (06_DATABASE_STANDARDS.md SD-004).
  warehouseCode String @db.VarChar(32) @map("warehouse_code")

  /// Warehouse name (00_BUSINESS_RULES.md Ch.37.1) — unique within its Branch (Ch.37.8).
  name String @db.VarChar(150) @map("name")

  /// Free-text description — no handbook-specified length; VarChar(500) mirrors Product's own `description` column.
  description String? @db.VarChar(500) @map("description")

  /// Warehouse lifecycle state (00_BUSINESS_RULES.md Ch.37.5): Active, Inactive.
  status WarehouseStatus @default(ACTIVE) @map("status")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@unique([branchUuid, warehouseCode, deletedAt], map: "uq_warehouses_branch_warehouse_code_deleted_at")
  @@unique([branchUuid, name, deletedAt], map: "uq_warehouses_branch_name_deleted_at")
  @@index([tenantId, branchUuid], map: "idx_warehouses_tenant_branch")
  @@index([branchUuid], map: "idx_warehouses_branch_uuid")
  @@index([tenantId, branchUuid, status], map: "idx_warehouses_tenant_branch_status")
  @@map("warehouses")
}

/// Mirrors 00_BUSINESS_RULES.md Ch.37.5 Warehouse lifecycle exactly (05_CODING_STANDARDS.md Ch.26.4), using the same two-value convention as BranchStatus (organization.prisma).
enum WarehouseStatus {
  ACTIVE
  INACTIVE

  @@map("warehouse_status")
}

// Stock (00_BUSINESS_RULES.md Ch.38: the current, real-time on-hand
// inventory quantity of a Product, Ch.34, held at a Warehouse, Ch.37, at a
// given point in time). Tenant-owned (`tenant_id`, MT-001). This table
// models ONLY the current-quantity snapshot per Ch.38's own Scope ("Owns:
// the current quantity on hand, quantity reserved... and quantity
// available... per Product per Warehouse") — the immutable movement history
// that this snapshot is derived from is Stock Movement's own future table
// (Ch.39), out of scope for this milestone.
//
// `companyUuid` and `warehouseUuid` are both cross-module references
// (FK-002, no DB-level FK): `companyUuid` to Organization's
// `companies.uuid`, mirroring Product's/Unit's/Product Category's own
// pattern; `warehouseUuid` to this same Inventory module's own
// `warehouses.uuid` — still FK-002, not a real in-module FK, because
// Warehouse's own identity is a `uuid` cross-module reference target by
// design (Organization's Branch owns Warehouse's real parent relationship,
// per Warehouse's own file-level Handbook Deviation note above), and no
// other in-module entity in this schema targets Warehouse by its internal
// `id` either. `productId`, by contrast, IS a real, in-module RESTRICT FK
// (FK-001) to this module's own `products.id` — mirroring
// `productCategoryId`'s/`unitId`'s own real-FK treatment on Product,
// since Product is owned by this same Inventory module.
//
// `quantityOnHand`/`quantityReserved`/`quantityAvailable` are all
// `DECIMAL(18,6)` — a fractional-quantity-safe precision/scale (e.g.
// partial units, weight-based stock) distinct from Unit's own
// `DECIMAL(20,10)` conversion-factor ratio; no handbook-documented
// precision/scale exists for a stock quantity either, so this is an
// explicitly flagged, undocumented but reasonable choice, not a silently
// invented one. All three default to `0` — a newly created Stock row
// always has a concrete, known quantity (never an absent/unknown value),
// mirroring Ch.38.11's example that stock quantities are always exact
// numbers, not nullable state. STK-001 ("quantity available = on hand
// minus reserved") is a derived, Business-layer computation, not a DB
// CHECK/GENERATED constraint — deferred to a later Business-layer
// milestone, mirroring how every other cross-column arithmetic rule in
// this schema (e.g. Ch.36.8's conversion-factor positivity) was likewise
// deferred at its own Database milestone.
//
// STK-003 ("Stock is tracked independently per Product per Warehouse — the
// same Product's Stock in two different Warehouses are entirely separate
// balances") is enforced here as "at most one (non-deleted) Stock row per
// Product per Warehouse" via the unique constraint below (including
// `deletedAt`, SD-004, reusable after soft delete) — mirroring every other
// natural-key unique constraint in this schema.
model Stock {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Cross-module reference to this module's own `warehouses.uuid` (FK-002) — no DB-level FK; Warehouse's own identity is a uuid-reference target by design (see Warehouse's own file-level Handbook Deviation note above).
  warehouseUuid String @db.Char(36) @map("warehouse_uuid")

  /// Real, in-module RESTRICT FK to this module's own Product (Ch.34) — required, STK-003 ("Stock... per Product per Warehouse").
  productId BigInt  @db.UnsignedBigInt @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Current quantity physically held (Ch.38.3) — DECIMAL(18,6), a flagged undocumented-but-reasonable precision/scale choice (see file-level note above).
  quantityOnHand Decimal @default(0) @db.Decimal(18, 6) @map("quantity_on_hand")

  /// Quantity allocated to unfulfilled Sales Orders (Ch.38.3/38.11) — not yet enforced against any Sales module, which doesn't exist yet.
  quantityReserved Decimal @default(0) @db.Decimal(18, 6) @map("quantity_reserved")

  /// Quantity available for new orders (Ch.38.11: on hand minus reserved) — a derived value, not DB-computed; STK-001's arithmetic is a Business-layer concern (a later milestone).
  quantityAvailable Decimal @default(0) @db.Decimal(18, 6) @map("quantity_available")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@unique([warehouseUuid, productId, deletedAt], map: "uq_stocks_warehouse_product_deleted_at")
  @@index([tenantId, companyUuid], map: "idx_stocks_tenant_company")
  @@index([companyUuid, warehouseUuid], map: "idx_stocks_company_warehouse")
  @@index([warehouseUuid, productId], map: "idx_stocks_warehouse_product")
  @@index([tenantId, companyUuid, warehouseUuid], map: "idx_stocks_tenant_company_warehouse")
  @@map("stocks")
}
