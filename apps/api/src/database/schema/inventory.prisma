// Inventory module — Prisma schema.
// Standards: 06_DATABASE_STANDARDS.md (Ch.2 Naming/Standard Columns, Ch.3 Primary
// Keys, Ch.4 Foreign Keys, Ch.5 Indexing, Ch.6 Multi-Tenant Isolation, Ch.8 Soft
// Delete). Business rules: 00_BUSINESS_RULES.md Ch.34 (Products), Ch.35 (Product
// Categories), Ch.36 (Units), Ch.37 (Warehouses), Ch.38 (Stock), Ch.39 (Stock
// Movement), Ch.40 (Batch), Ch.41 (Serial Numbers), Ch.42 (Reorder Levels),
// Ch.43 (Stock Valuation), Ch.44 (Inventory Adjustment).
//
// Module ownership: this module owns Product Category (Ch.35), Unit (Ch.36),
// Product (Ch.34), Warehouse (Ch.37), Stock (Ch.38), Stock Movement (Ch.39),
// Batch (Ch.40), Serial Number (Ch.41), Reorder Level (Ch.42), Stock
// Valuation (Ch.43), and Inventory Adjustment (Ch.44).
//
// Milestone history: Product Category (Ch.35) and Unit (Ch.36) were each
// carried through their own Database milestones and are complete (see
// engineering/implementation/current-phase.md) — not modified by this
// milestone. This milestone adds Product (Ch.34) — Database layer ONLY, per
// explicit instruction, mirroring how Product Category's/Unit's own first
// milestones started (single entity, single layer, then stop). A later
// revision added Warehouse (Ch.37) — Database layer ONLY, same
// single-entity, single-layer, then-stop pattern. A later revision added
// Stock (Ch.38) — Database layer ONLY, the current on-hand-inventory
// snapshot per Product per Warehouse. A later revision added Inventory
// Adjustment (Ch.44) — Database layer ONLY, the manual correction record.
// A later revision added Stock Movement (Ch.39) — Database layer ONLY, the
// immutable append-only ledger of every quantity change to Stock, modeled
// with a dual source/destination Warehouse relationship per Ch.39.10's own
// ERD (required to make STM-003's single-atomic-Transfer rule achievable at
// all) and a four-value RECEIPT/ISSUE/TRANSFER/ADJUSTMENT movement-type enum
// per Ch.39.1's own named business event kinds — see that model's own
// file-level comment for the full reasoning, including why an earlier
// single-warehouse/IN-OUT draft of that same milestone was rolled back and
// replaced rather than kept. This revision adds Batch (Ch.40) — Database
// layer ONLY. Unlike every prior Inventory milestone, Chapter 40 could not
// be modeled as an isolated new table alone: BAT-001 ("A Batch-tracked
// Product's every Stock Movement... must reference a specific Batch") and
// Ch.40.10's own ERD (`BATCH ||--o{ STOCK_MOVEMENT`) require `StockMovement`
// (already shipped) to carry a real, nullable `batchId` FK back to this new
// table, and Ch.40.9/40.6 ("Product... must be configured as Batch-tracked")
// require `Product` (already shipped) to carry a new `isBatchTracked`
// boolean. Both extensions were explicitly authorized by the user
// (flagged and resolved, not guessed) after the conflict was raised;
// both new columns are nullable/defaulted for backward compatibility, and
// every cross-column invariant they introduce (batchId required only when
// isBatchTracked, expiryDate-after-manufactureDate per Ch.40.8) is deferred
// to a future Business-layer milestone, never a DB CHECK constraint, per
// this milestone's own explicit instruction. Serial Number (Ch.41), Reorder
// Level (Ch.42), and Stock Valuation (Ch.43) remain unstarted; no table is
// modeled for any of them yet. Repository/Business/Presentation/Integration/
// Frontend layers for Product, Warehouse, Stock, Inventory Adjustment,
// Stock Movement, and Batch are also not started — stop condition for this
// milestone.
//
// `productCategoryId` and `unitId` are real, in-module RESTRICT foreign keys
// (FK-001) — NOT the uuid-reference pattern (FK-002), because Product
// Category and Unit are both owned by this same Inventory module, unlike
// `companyUuid` (a genuine cross-module reference into Organization). This
// mirrors ProductCategory's own self-referential FK and Unit's own
// `baseUnitId` FK, both real in-module FKs targeting `id`.
//
// `unitId` is nullable: 00_BUSINESS_RULES.md Ch.34.8 requires a Unit of
// Measure only for a Stocked Product ("a Stocked Product must specify a Unit
// of Measure") — a Non-Stocked (service) Product has none. Enforcing "must
// be set when isStocked is true" is a Business-layer concern (a later
// milestone), not a DB CHECK constraint, mirroring Unit's own nullable
// `conversionFactor` (required only when `baseUnitId` is set) reasoning.
//
// `productCode` (PRD-001, "unique identifying code within the Company") is
// unique per Company with `deletedAt` in the constraint (06_DATABASE_
// STANDARDS.md SD-004) — reusable after soft delete, mirroring Organization's
// own `companyCode`/`branchCode`/`departmentCode` pattern; no handbook rule
// forbids reuse the way COA-003/004 does for Chart of Accounts codes.
//
// `status` (ProductStatus: Draft/Active/Discontinued) models Ch.34.5's
// documented lifecycle state diagram exactly, mirroring Role's own
// `RoleStatus` enum pattern (05_CODING_STANDARDS.md Ch.26.4). PRD-003 ("a
// Product cannot be Discontinued while it has non-zero Stock on hand") and
// Ch.34.12's "Stocked classification is fixed once transacted" are both
// Business-layer validations (later milestones, depend on Stock/Ch.38 which
// doesn't exist yet) — not enforced at this layer.
//
// Product Category is tenant-owned (`tenant_id`, MT-001) with `companyUuid`
// as a cross-module reference (FK-002) to Organization's `companies.uuid` —
// no DB-level FK, mirroring Financial Year's/Account Group's own
// `companyUuid` pattern. This matches Ch.34.9 ("[Product] Depends on:
// Company") — Products, and therefore the Categories that classify them, are
// scoped per Company, consistent with Ch.2.16's "Inventory ... is tracked
// per Company."
//
// `parentProductCategoryId` is a real, in-module RESTRICT self-referential FK
// (Ch.35.10's ERD: "PRODUCT_CATEGORY ||--o{ PRODUCT_CATEGORY : may have
// sub-categories"), mirroring Account Group's own self-referential hierarchy
// (Ch.18.7 AGP-003).
//
// `defaultTaxGroupUuid` is a cross-module reference (FK-002, no DB-level FK)
// to Accounting's `tax_groups.uuid` (Ch.67) — the category-level default Tax
// Group Ch.35.3/PCT-002 describes ("Category-level defaults... apply to a
// Product only if the Product does not explicitly override them").
//
// Handbook Deviation (flagged, not guessed): Ch.35.3 also names a
// category-level "default Unit of Measure" — NOT modeled here, since Unit
// (Ch.36) has no table yet in this codebase; adding a column referencing a
// nonexistent entity would be invention. To be added once Unit has its own
// Database milestone, mirroring how Journal Entry's Voucher/Cost Center
// references were deferred for the same reason.
//
// `name` uniqueness "within its hierarchy level" (Ch.35.8) is only partially
// enforced by `uq_product_categories_company_parent_name_deleted_at` below —
// MySQL's unique index treats every NULL `parent_product_category_id` as
// distinct, so two top-level (root) Categories under the same Company could
// still share a name without violating this constraint. True sibling-name
// uniqueness (including at the root level) is deferred to a later
// Business-layer milestone, mirroring how Financial Year's own overlap
// validation was only partially DB-protected and finished at the Business
// layer.
model ProductCategory {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Product Category name (00_BUSINESS_RULES.md Ch.35.1) — intended to be unique within its hierarchy level (Ch.35.8); see the file-level Handbook Deviation note on the partial DB constraint below.
  name String @db.VarChar(100) @map("name")

  /// Self-referential parent for nested Categories (Ch.35.1/35.10 "may have sub-categories").
  parentProductCategoryId BigInt?           @db.UnsignedBigInt @map("parent_product_category_id")
  parentProductCategory   ProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentProductCategoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  childProductCategories  ProductCategory[] @relation("ProductCategoryHierarchy")

  /// Back-relation for Product's real, in-module RESTRICT FK (Ch.34.9) — this milestone's Database layer only, no repository/service reads this relation yet.
  products Product[]

  /// Cross-module reference to Accounting's `tax_groups.uuid` (Ch.67) — category-level default Tax Group (Ch.35.3/PCT-002), FK-002, no DB-level FK. A Product may override this (Ch.35.12).
  defaultTaxGroupUuid String? @db.Char(36) @map("default_tax_group_uuid")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@unique([companyUuid, parentProductCategoryId, name, deletedAt], map: "uq_product_categories_company_parent_name_deleted_at")
  @@index([tenantId, companyUuid], map: "idx_product_categories_tenant_company")
  @@index([companyUuid, parentProductCategoryId], map: "idx_product_categories_company_parent")
  @@map("product_categories")
}

// Unit of Measure (00_BUSINESS_RULES.md Ch.36: quantity-measurement
// convention for a Product, Ch.34 — e.g. Pieces, Kilograms, Liters, Boxes —
// including conversion factors between related units). Tenant-owned
// (`tenant_id`, MT-001) with `companyUuid` as a cross-module reference
// (FK-002) to Organization's `companies.uuid` — no DB-level FK, mirroring
// Product Category's/Account Group's own `companyUuid` pattern.
//
// Ch.36.5 describes Units as "largely platform-provided" reference data
// "with Company-specific custom units as needed" — the identical
// platform-template-vs-Company-instance ambiguity Account Group's own
// Ch.18.5 raised (that milestone's own carried-forward open design
// question, per `engineering/implementation/current-phase.md`). Resolved
// here the same way: a plain tenant/company-owned table, not a nullable-
// tenant platform/tenant hybrid schema — the platform-template seeding
// workflow remains an explicitly deferred, not-yet-designed mechanism
// (likely a future seed script populating each Company's own rows), not a
// schema-level distinction this milestone invents.
//
// `baseUnitId` is a real, in-module RESTRICT self-referential FK — Ch.36.1/
// 36.3's "conversion factor to a defined base unit where applicable" and
// Ch.36.11's worked example (a "Box of 100" alternate Unit pointing to a
// "Pieces" base Unit). `null` on a Unit row means that row IS a base unit
// itself (Ch.36.7 UNT-001's "exactly one base Unit" per Stocked Product is
// therefore expressed as the Product's own future `baseUnitId` reference,
// a Ch.34/Product-table concern, not modeled here). `conversionFactor` is
// likewise nullable — required only when `baseUnitId` is set; Ch.36.8's
// "must be a positive number" validation is a Business-layer concern (a
// later milestone), not a DB CHECK constraint. `DECIMAL(20,10)` mirrors
// Exchange Rate's own `rate` column precision/scale exactly (a ratio, not
// a currency-precision amount) — no handbook-documented precision/scale
// exists for a conversion factor either, so this is the same flagged
// Handbook Deviation carried forward, not a newly invented one.
model Unit {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Unit name (00_BUSINESS_RULES.md Ch.36.1, e.g. "Pieces", "Kilograms", "Box of 100").
  name String @db.VarChar(100) @map("name")

  /// Short display symbol (Ch.36.3, e.g. "Pcs", "Kg", "L") — no handbook-specified length; VarChar(20) is a reasonable, undocumented choice mirroring other short-string columns in this schema.
  symbol String @db.VarChar(20) @map("symbol")

  /// Self-referential base Unit this row converts to (Ch.36.1/36.3/36.11) — null means this row IS a base Unit.
  baseUnitId BigInt? @db.UnsignedBigInt @map("base_unit_id")
  baseUnit   Unit?   @relation("UnitConversion", fields: [baseUnitId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  alternateUnits Unit[] @relation("UnitConversion")

  /// Back-relation for Product's real, in-module RESTRICT FK (Ch.34.9) — this milestone's Database layer only, no repository/service reads this relation yet.
  products Product[]

  /// Conversion factor to `baseUnit` (Ch.36.1/36.3/36.7 UNT-002, e.g. 100 for "Box of 100" -> "Pieces") — required only when `baseUnitId` is set; positivity (Ch.36.8) is a Business-layer concern.
  conversionFactor Decimal? @db.Decimal(20, 10) @map("conversion_factor")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  /// Partial duplicate-name protection per Company (06_DATABASE_STANDARDS.md SD-004 pattern) — not explicit handbook text, mirroring Tax Group's/Account Group's own identical `uq_..._tenant_company_name_deleted_at` reasoning.
  @@unique([tenantId, companyUuid, name, deletedAt], map: "uq_units_tenant_company_name_deleted_at")
  @@index([tenantId, companyUuid], map: "idx_units_tenant_company")
  @@index([companyUuid], map: "idx_units_company_uuid")
  @@map("units")
}

// Product (00_BUSINESS_RULES.md Ch.34: the master-data record describing an
// item a Company buys, sells, manufactures, or stocks — item name,
// description, Product Category, Unit of Measure, and Stocked/Non-Stocked
// classification). Tenant-owned (`tenant_id`, MT-001) with `companyUuid` as
// a cross-module reference (FK-002) to Organization's `companies.uuid` — no
// DB-level FK, mirroring Product Category's/Unit's own `companyUuid`
// pattern, consistent with Ch.34.9 ("Depends on: Company").
//
// `productCategoryId`/`unitId` are real, in-module RESTRICT foreign keys
// (FK-001), not cross-module uuid references — see the file-level note
// above. `productCategoryId` is required (PCT-001: "Every Product must be
// assigned to exactly one Product Category"); `unitId` is nullable (Ch.34.8:
// required only for a Stocked Product, a Business-layer concern).
//
// `status` (ProductStatus) models Ch.34.5's Draft → Active → Discontinued
// lifecycle; transition validation (e.g. PRD-003) is a Business-layer
// concern, not modeled here.
model Product {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Unique identifying code within the Company (00_BUSINESS_RULES.md Ch.34.7 PRD-001) — reusable after soft delete (06_DATABASE_STANDARDS.md SD-004), mirroring Organization's own `companyCode`/`branchCode`/`departmentCode` pattern.
  productCode String @db.VarChar(32) @map("product_code")

  /// Product name (00_BUSINESS_RULES.md Ch.34.3).
  name String @db.VarChar(150) @map("name")

  /// Free-text item description (Ch.34.3).
  description String? @db.VarChar(500) @map("description")

  /// Real, in-module RESTRICT FK to this module's own Product Category (Ch.35) — required, PCT-001.
  productCategoryId BigInt          @db.UnsignedBigInt @map("product_category_id")
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Real, in-module RESTRICT FK to this module's own Unit (Ch.36) — nullable; required only for a Stocked Product (Ch.34.8), a Business-layer concern.
  unitId BigInt? @db.UnsignedBigInt @map("unit_id")
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Back-relation for Stock's real, in-module RESTRICT FK (Ch.38.9) — this milestone's Database layer only, no repository/service reads this relation yet.
  stocks Stock[]

  /// Back-relation for Inventory Adjustment's real, in-module RESTRICT FK (Ch.44.3) — this milestone's Database layer only, no repository/service reads this relation yet.
  inventoryAdjustments InventoryAdjustment[]

  /// Back-relation for Stock Movement's real, in-module RESTRICT FK (Ch.39) — this milestone's Database layer only, no repository/service reads this relation yet.
  stockMovements StockMovement[]

  /// Back-relation for Batch's real, in-module RESTRICT FK (Ch.40.9/40.10 "PRODUCT ||--o{ BATCH") — this milestone's Database layer only, no repository/service reads this relation yet.
  batches Batch[]

  /// Back-relation for Reorder Level's real, in-module RESTRICT FK (Ch.42.10 "PRODUCT }o--o{ WAREHOUSE") — this milestone's Database layer only, no repository/service reads this relation yet. A Prisma-required relation-metadata field only; adds no column to this table (confirmed via `SHOW CREATE TABLE products`).
  reorderLevels ReorderLevel[]

  /// Stocked (tracked in Inventory) vs. Non-Stocked (e.g. a service) classification, set at creation (Ch.34.7 PRD-002). Immutability once transacted (Ch.34.12) is a Business-layer concern.
  isStocked Boolean @map("is_stocked")

  /// Batch-tracking configuration (00_BUSINESS_RULES.md Ch.40.6/40.9: "Product configured as Batch-tracked (Ch.34 attribute)" / "must be configured as Batch-tracked") — added by the Batch (Ch.40) milestone, extending this already-shipped Product table because Ch.40 explicitly requires it, not a Ch.34-originated field. Defaults `false` for backward compatibility with every existing Product row. BAT-001's "every Stock Movement... must reference a specific Batch" enforcement (checking this flag before requiring `StockMovement.batchId`) is a Business-layer concern, not a DB CHECK constraint.
  isBatchTracked Boolean @default(false) @map("is_batch_tracked")

  /// Product lifecycle state (00_BUSINESS_RULES.md Ch.34.5): Draft, Active, Discontinued.
  status ProductStatus @default(DRAFT) @map("status")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@unique([companyUuid, productCode, deletedAt], map: "uq_products_company_product_code_deleted_at")
  @@index([tenantId, companyUuid], map: "idx_products_tenant_company")
  @@index([companyUuid, productCategoryId], map: "idx_products_company_category")
  @@index([tenantId, companyUuid, status], map: "idx_products_tenant_company_status")
  @@map("products")
}

/// Mirrors 00_BUSINESS_RULES.md Ch.34.5 Product lifecycle exactly (05_CODING_STANDARDS.md Ch.26.4).
enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED

  @@map("product_status")
}

// Warehouse (00_BUSINESS_RULES.md Ch.37: a physical stock-keeping location
// within a Branch where Inventory, Ch.38, is physically held). Tenant-owned
// (`tenant_id`, MT-001).
//
// Handbook Deviation (flagged, not guessed): this milestone's own prompt
// asked for a `companyUuid` cross-module reference, mirroring Product
// Category's/Unit's/Product's own `companyUuid` pattern. However,
// WHS-001 ("Every Warehouse belongs to exactly one Branch") and Ch.37.9's
// Dependencies ("Depends on: Branch (Ch.3)") and Ch.37.10's ERD
// (`BRANCH ||--o{ WAREHOUSE : "contains"`) all describe Warehouse as a
// child of Branch, not of Company directly — Company is only reachable
// transitively through Branch (Branch itself owns a real `companyId` FK,
// organization.prisma). Per CLAUDE.md Ch.5/Ch.13/Ch.27 ("the handbook
// wins... never assume a business rule not documented... ask instead"),
// this was raised with the user, who confirmed: model the real WHS-001
// relationship as `branchUuid` (FK-002, cross-module reference to
// Organization's `branches.uuid` — no DB-level FK, since Branch lives in a
// different module, mirroring Product/Unit/ProductCategory's own
// `companyUuid` FK-002 pattern exactly) and drop `companyUuid` entirely,
// since Company is not Warehouse's direct parent.
//
// `warehouseCode` and `name` are each unique per Branch (Ch.37.8: "Warehouse
// name must be unique within its Branch") including `deletedAt` in the
// constraint (06_DATABASE_STANDARDS.md SD-004, reusable after soft delete),
// mirroring Branch's own `branchCode`/`branchName` dual-unique pattern
// (organization.prisma) rather than Product's single combined-code unique.
//
// `status` (WarehouseStatus: Active/Inactive) mirrors Ch.37.5's Business
// Lifecycle exactly, using the same two-value convention as `BranchStatus`
// (organization.prisma) rather than Product's three-value lifecycle.
// WHS-002 ("cannot be deactivated while it holds non-zero Stock") is a
// Business-layer concern (a later milestone, depends on Stock/Ch.38 which
// doesn't exist yet) — not enforced at this layer.
model Warehouse {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `branches.uuid` (FK-002) — no DB-level FK. Warehouse's real parent per WHS-001/Ch.37.9/37.10 (not Company directly — see file-level Handbook Deviation note above).
  branchUuid String @db.Char(36) @map("branch_uuid")

  /// Unique identifying code within the Branch (mirrors Branch's own `branchCode`/Product's `productCode` convention) — reusable after soft delete (06_DATABASE_STANDARDS.md SD-004).
  warehouseCode String @db.VarChar(32) @map("warehouse_code")

  /// Warehouse name (00_BUSINESS_RULES.md Ch.37.1) — unique within its Branch (Ch.37.8).
  name String @db.VarChar(150) @map("name")

  /// Free-text description — no handbook-specified length; VarChar(500) mirrors Product's own `description` column.
  description String? @db.VarChar(500) @map("description")

  /// Warehouse lifecycle state (00_BUSINESS_RULES.md Ch.37.5): Active, Inactive.
  status WarehouseStatus @default(ACTIVE) @map("status")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@unique([branchUuid, warehouseCode, deletedAt], map: "uq_warehouses_branch_warehouse_code_deleted_at")
  @@unique([branchUuid, name, deletedAt], map: "uq_warehouses_branch_name_deleted_at")
  @@index([tenantId, branchUuid], map: "idx_warehouses_tenant_branch")
  @@index([branchUuid], map: "idx_warehouses_branch_uuid")
  @@index([tenantId, branchUuid, status], map: "idx_warehouses_tenant_branch_status")
  @@map("warehouses")
}

/// Mirrors 00_BUSINESS_RULES.md Ch.37.5 Warehouse lifecycle exactly (05_CODING_STANDARDS.md Ch.26.4), using the same two-value convention as BranchStatus (organization.prisma).
enum WarehouseStatus {
  ACTIVE
  INACTIVE

  @@map("warehouse_status")
}

// Stock (00_BUSINESS_RULES.md Ch.38: the current, real-time on-hand
// inventory quantity of a Product, Ch.34, held at a Warehouse, Ch.37, at a
// given point in time). Tenant-owned (`tenant_id`, MT-001). This table
// models ONLY the current-quantity snapshot per Ch.38's own Scope ("Owns:
// the current quantity on hand, quantity reserved... and quantity
// available... per Product per Warehouse") — the immutable movement history
// that this snapshot is derived from is Stock Movement's own future table
// (Ch.39), out of scope for this milestone.
//
// `companyUuid` and `warehouseUuid` are both cross-module references
// (FK-002, no DB-level FK): `companyUuid` to Organization's
// `companies.uuid`, mirroring Product's/Unit's/Product Category's own
// pattern; `warehouseUuid` to this same Inventory module's own
// `warehouses.uuid` — still FK-002, not a real in-module FK, because
// Warehouse's own identity is a `uuid` cross-module reference target by
// design (Organization's Branch owns Warehouse's real parent relationship,
// per Warehouse's own file-level Handbook Deviation note above), and no
// other in-module entity in this schema targets Warehouse by its internal
// `id` either. `productId`, by contrast, IS a real, in-module RESTRICT FK
// (FK-001) to this module's own `products.id` — mirroring
// `productCategoryId`'s/`unitId`'s own real-FK treatment on Product,
// since Product is owned by this same Inventory module.
//
// `quantityOnHand`/`quantityReserved`/`quantityAvailable` are all
// `DECIMAL(18,6)` — a fractional-quantity-safe precision/scale (e.g.
// partial units, weight-based stock) distinct from Unit's own
// `DECIMAL(20,10)` conversion-factor ratio; no handbook-documented
// precision/scale exists for a stock quantity either, so this is an
// explicitly flagged, undocumented but reasonable choice, not a silently
// invented one. All three default to `0` — a newly created Stock row
// always has a concrete, known quantity (never an absent/unknown value),
// mirroring Ch.38.11's example that stock quantities are always exact
// numbers, not nullable state. STK-001 ("quantity available = on hand
// minus reserved") is a derived, Business-layer computation, not a DB
// CHECK/GENERATED constraint — deferred to a later Business-layer
// milestone, mirroring how every other cross-column arithmetic rule in
// this schema (e.g. Ch.36.8's conversion-factor positivity) was likewise
// deferred at its own Database milestone.
//
// STK-003 ("Stock is tracked independently per Product per Warehouse — the
// same Product's Stock in two different Warehouses are entirely separate
// balances") is enforced here as "at most one (non-deleted) Stock row per
// Product per Warehouse" via the unique constraint below (including
// `deletedAt`, SD-004, reusable after soft delete) — mirroring every other
// natural-key unique constraint in this schema.
model Stock {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Cross-module reference to this module's own `warehouses.uuid` (FK-002) — no DB-level FK; Warehouse's own identity is a uuid-reference target by design (see Warehouse's own file-level Handbook Deviation note above).
  warehouseUuid String @db.Char(36) @map("warehouse_uuid")

  /// Real, in-module RESTRICT FK to this module's own Product (Ch.34) — required, STK-003 ("Stock... per Product per Warehouse").
  productId BigInt  @db.UnsignedBigInt @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Current quantity physically held (Ch.38.3) — DECIMAL(18,6), a flagged undocumented-but-reasonable precision/scale choice (see file-level note above).
  quantityOnHand Decimal @default(0) @db.Decimal(18, 6) @map("quantity_on_hand")

  /// Quantity allocated to unfulfilled Sales Orders (Ch.38.3/38.11) — not yet enforced against any Sales module, which doesn't exist yet.
  quantityReserved Decimal @default(0) @db.Decimal(18, 6) @map("quantity_reserved")

  /// Quantity available for new orders (Ch.38.11: on hand minus reserved) — a derived value, not DB-computed; STK-001's arithmetic is a Business-layer concern (a later milestone).
  quantityAvailable Decimal @default(0) @db.Decimal(18, 6) @map("quantity_available")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@unique([warehouseUuid, productId, deletedAt], map: "uq_stocks_warehouse_product_deleted_at")
  @@index([tenantId, companyUuid], map: "idx_stocks_tenant_company")
  @@index([companyUuid, warehouseUuid], map: "idx_stocks_company_warehouse")
  @@index([warehouseUuid, productId], map: "idx_stocks_warehouse_product")
  @@index([tenantId, companyUuid, warehouseUuid], map: "idx_stocks_tenant_company_warehouse")
  @@map("stocks")
}

// Inventory Adjustment (00_BUSINESS_RULES.md Ch.44: a manual correction to
// Stock's, Ch.38, quantity — arising from a physical count reconciliation,
// damage, loss, or theft — distinct from the ordinary transactional Stock
// Movements, Ch.39, that Sales/Purchase/Transfer processes generate).
// Tenant-owned (`tenant_id`, MT-001). This Database-only milestone models
// ONLY the adjustment record itself, per Ch.44.3's own "Owns:" list ("the
// adjustment quantity..., the reason code...") — the Stock Movement and
// Journal Entry each Adjustment atomically generates (ADJ-002), the
// approval-threshold workflow (ADJ-003/Ch.13), and the actual application of
// this adjustment against Stock's own on-hand quantity (Ch.38) are all
// out of scope, deferred to later Repository/Business milestones, mirroring
// how Stock's own STK-001 arithmetic was deferred at its Database milestone.
//
// `companyUuid` and `warehouseUuid` are both cross-module references
// (FK-002, no DB-level FK) — explicitly NOT modeled as real foreign keys per
// this milestone's own instruction, mirroring Stock's identical treatment of
// both fields (see Stock's own file-level comment above for the full
// reasoning: `warehouseUuid` targets this same module's own Warehouse by
// `uuid`, not `id`, since Warehouse's real parent relationship lives via
// Organization's Branch). `productId`, by contrast, IS a real, in-module
// RESTRICT FK (FK-001) to this module's own `products.id` — the one
// relationship this milestone's own instruction explicitly asked for,
// mirroring Stock's identical `productId` FK treatment exactly.
//
// `adjustmentType` (AdjustmentType: INCREASE/DECREASE) models Ch.44.3's
// "adjustment quantity (positive or negative)" as an explicit direction flag
// alongside an always-positive `quantity` magnitude, rather than a single
// signed quantity column — an explicitly flagged, undocumented-but-
// reasonable modeling choice (the handbook describes the concept, not the
// column shape), consistent with how Stock's own quantity precision/scale
// was similarly flagged. `quantity` is `DECIMAL(18,6)`, mirroring Stock's
// own quantity columns exactly (fractional-quantity-safe).
//
// `reason` (ADJ-001: "Every Inventory Adjustment must specify a reason code
// — an unexplained quantity change is never permitted") is modeled as a
// plain `VARCHAR`, not an enum — Ch.44.7 names example reason codes inline
// ("physical count variance, damage, theft, expiry write-off") but documents
// no closed, exhaustive list the way `ProductStatus`/`WarehouseStatus` have
// one; a plain string field is not silently narrower than the handbook
// warrants — mirroring `narration`'s own free-text treatment on
// `JournalEntry`. `remarks` is a separate, optional free-text field for
// additional detail beyond the reason code, per this milestone's own
// explicit field list.
//
// No uniqueness constraint across `(warehouseUuid, productId)` — unlike
// Stock's own STK-003 "at most one row" rule, Inventory Adjustment is a
// transactional, append-style record: the same Product in the same
// Warehouse may legitimately be adjusted many times over its history.
model InventoryAdjustment {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK, mirroring Stock's own `companyUuid` treatment.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Cross-module reference to this module's own `warehouses.uuid` (FK-002) — no DB-level FK, mirroring Stock's own `warehouseUuid` treatment.
  warehouseUuid String @db.Char(36) @map("warehouse_uuid")

  /// Real, in-module RESTRICT FK to this module's own Product (Ch.34) — required, mirroring Stock's own `productId` FK treatment; the one relationship this milestone's own instruction asked for.
  productId BigInt  @db.UnsignedBigInt @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Direction of the correction (Ch.44.3: "adjustment quantity (positive or negative)") — modeled as an explicit flag alongside an always-positive `quantity` magnitude.
  adjustmentType AdjustmentType @map("adjustment_type")

  /// Magnitude of the correction — DECIMAL(18,6), mirroring Stock's own quantity columns exactly (fractional-quantity-safe).
  quantity Decimal @db.Decimal(18, 6) @map("quantity")

  /// Reason code (ADJ-001: mandatory, "an unexplained quantity change is never permitted") — plain text, since Ch.44.7 documents example values, not a closed enumerated list.
  reason String @db.VarChar(255) @map("reason")

  /// Optional free-text detail beyond the reason code.
  remarks String? @db.VarChar(500) @map("remarks")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@index([tenantId, companyUuid], map: "idx_inventory_adjustments_tenant_company")
  @@index([warehouseUuid, productId], map: "idx_inventory_adjustments_warehouse_product")
  @@index([productId], map: "idx_inventory_adjustments_product")
  @@map("inventory_adjustments")
}

/// Mirrors 00_BUSINESS_RULES.md Ch.44.3's "adjustment quantity (positive or negative)" as an explicit direction flag (05_CODING_STANDARDS.md Ch.26.4).
enum AdjustmentType {
  INCREASE
  DECREASE

  @@map("adjustment_type")
}

// Stock Movement (00_BUSINESS_RULES.md Ch.39: "the record of any event that
// changes Stock (Ch.38) quantity — a Receipt (incoming), an Issue (outgoing),
// a Transfer (between Warehouses), or an Adjustment (Ch.44) — forming the
// complete, immutable history that Stock's current quantity is derived
// from," Ch.39.1). Tenant-owned (`tenant_id`, MT-001), `companyUuid` a
// cross-module reference (FK-002, no DB-level FK) — the same MT-001 scoping
// every other table in this module already carries, not a Ch.39-specific
// invention. This Database-only milestone models ONLY the movement record
// itself, per Ch.39.4's own Scope ("the movement record itself... Out of
// scope: the business transactions that trigger movements") — the process
// that actually applies a movement against Stock's own on-hand quantity, and
// the Goods Receipt/Delivery/Transfer/Adjustment workflows that each
// generate movements, are all out of scope, deferred to later
// Repository/Business milestones.
//
// `productId` is a real, in-module RESTRICT FK (FK-001) to this module's own
// `products.id`, mirroring Stock's/Inventory Adjustment's own `productId`
// treatment — Ch.39.10's ERD models this as `STOCK_MOVEMENT }o--|| PRODUCT :
// "involves"` (required, many-to-one).
//
// `sourceWarehouseUuid`/`destinationWarehouseUuid` implement Ch.39.10's ERD
// literally: `STOCK_MOVEMENT }o--o| WAREHOUSE : "source"` and `}o--o|
// WAREHOUSE : "destination"` — TWO independent, optional Warehouse
// relationships on the same row, not one. This is required by STM-003 ("A
// Transfer movement between two Warehouses must record both the decrease at
// the source Warehouse and the increase at the destination Warehouse as one
// atomic movement — a Transfer can never leave stock counted at neither or
// both locations simultaneously"): a single-warehouse-per-row shape cannot
// express a Transfer without either losing one side or splitting it into two
// rows, which STM-003 explicitly forbids (39.20's own "Common Mistakes"
// table names exactly this failure mode: "Recording a Transfer as two
// independent, unlinked movements"). Both are cross-module references
// (FK-002, no DB-level FK) to this module's own `warehouses.uuid`, mirroring
// Stock's/Inventory Adjustment's identical `warehouseUuid` treatment (no
// other in-module entity in this schema targets Warehouse by its internal
// `id`; Warehouse's real parent relationship lives via Organization's
// Branch, per Warehouse's own file-level Handbook Deviation note above).
// Which side(s) a given `movementType` populates (Receipt: destination only;
// Issue: source only; Transfer: both; Adjustment: whichever side the
// underlying Ch.44 adjustment direction implies) is a cross-column
// invariant, not a MySQL/Prisma-expressible declarative constraint — a
// Business-layer concern, deferred the same way every other cross-column
// invariant in this schema has been (e.g. STK-001, TXR-001 overlap,
// Unit.conversionFactor-required-only-when-baseUnitId-set).
//
// `movementType` (StockMovementType) is modeled with Ch.39.1's own four
// named business event kinds — RECEIPT, ISSUE, TRANSFER, ADJUSTMENT — not a
// two-value direction flag; a two-value IN/OUT flag cannot represent a
// Transfer, which is neither a pure inbound nor pure outbound event but
// both simultaneously (STM-003).
//
// `quantity` is `DECIMAL(18,6)`, mirroring Stock's/Inventory Adjustment's own
// quantity columns exactly (fractional-quantity-safe) — no handbook-
// documented precision/scale exists for a movement quantity either,
// carrying forward the same already-flagged deviation those two models
// established, not a newly invented one.
//
// `referenceType`/`referenceUuid` are a polymorphic, nullable pointer to the
// originating business transaction (Ch.39.3's "reference to the originating
// business transaction (Goods Receipt, Delivery, Transfer request)," 39.19's
// "reference its originating business transaction... except for legitimate
// manual Adjustments" — hence nullable) — no DB-level FK, since the
// referenced entity varies by `referenceType` and may live in a different
// module (Goods Receipt/Ch.57, Delivery/Ch.49 don't have tables yet either).
//
// No `updatedAt`/`updatedBy`/`deletedAt` at all, and no uniqueness
// constraint — mirroring `LedgerEntry`'s own identical immutability posture
// (accounting.prisma) exactly, not an independently invented choice: Ch.39.5
// ("created and immediately final — like a Ledger entry (Ch.19.5), it is
// immutable once recorded") and STM-002 ("immutable once recorded —
// correction requires a new, offsetting Stock Movement, never a direct
// edit") are the same rule as Ch.19's own LDG-002 wording that justified
// `LedgerEntry` dropping every mutable/soft-delete column. `createdBy`
// remains nullable, also mirroring `LedgerEntry`'s own reasoning (a
// system-triggered posting process, not always a direct human action).
model StockMovement {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK, mirroring Stock's/Inventory Adjustment's own `companyUuid` treatment.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Real, in-module RESTRICT FK to this module's own Product (Ch.34) — required, per Ch.39.10's ERD (`STOCK_MOVEMENT }o--|| PRODUCT : "involves"`).
  productId BigInt  @db.UnsignedBigInt @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Cross-module reference to this module's own `warehouses.uuid` (FK-002) — no DB-level FK. Optional per Ch.39.10's ERD (`}o--o| WAREHOUSE : "source"`) — populated for Issue/Transfer, null for a pure Receipt.
  sourceWarehouseUuid String? @db.Char(36) @map("source_warehouse_uuid")

  /// Cross-module reference to this module's own `warehouses.uuid` (FK-002) — no DB-level FK. Optional per Ch.39.10's ERD (`}o--o| WAREHOUSE : "destination"`) — populated for Receipt/Transfer, null for a pure Issue.
  destinationWarehouseUuid String? @db.Char(36) @map("destination_warehouse_uuid")

  /// Business event kind (00_BUSINESS_RULES.md Ch.39.1): Receipt, Issue, Transfer, or Adjustment — not a direction flag, since Transfer is simultaneously inbound and outbound (STM-003).
  movementType StockMovementType @map("movement_type")

  /// Magnitude of the quantity change — DECIMAL(18,6), mirroring Stock's/Inventory Adjustment's own quantity columns exactly (fractional-quantity-safe).
  quantity Decimal @db.Decimal(18, 6) @map("quantity")

  /// Polymorphic pointer to the originating business transaction's type (Ch.39.3: Goods Receipt, Delivery, Transfer request) — no DB-level FK, since the referenced entity varies by type and may live in a different, not-yet-built module.
  referenceType String? @db.VarChar(50) @map("reference_type")

  /// Polymorphic pointer to the originating business transaction's `uuid`, paired with `referenceType` — no DB-level FK. Nullable per Ch.39.19 (a manual Adjustment may legitimately have none).
  referenceUuid String? @db.Char(36) @map("reference_uuid")

  /// Real, in-module RESTRICT FK to this module's own Batch (00_BUSINESS_RULES.md Ch.40.10 ERD: "BATCH ||--o{ STOCK_MOVEMENT : referenced by"; BAT-001: "A Batch-tracked Product's every Stock Movement... must reference a specific Batch") — added by the Batch (Ch.40) milestone, extending this already-shipped, immutable table because Ch.40 explicitly requires it. Nullable for backward compatibility with every existing row and because BAT-001 only applies to a Batch-tracked Product's movements — a non-Batch-tracked Product's movement legitimately has none. Enforcing "required when the Product is Batch-tracked" is a Business-layer concern (checked against `Product.isBatchTracked`), not a DB NOT NULL/CHECK constraint.
  batchId BigInt? @db.UnsignedBigInt @map("batch_id")
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  createdAt DateTime @default(now()) @db.DateTime(3) @map("created_at")
  /// Nullable — mirrors `LedgerEntry.createdBy`'s own reasoning: attributable to a system-triggered posting process, not always a direct human action.
  createdBy BigInt?  @db.UnsignedBigInt @map("created_by")

  @@index([tenantId, companyUuid], map: "idx_stock_movements_tenant_company")
  @@index([sourceWarehouseUuid, productId], map: "idx_stock_movements_source_warehouse_product")
  @@index([destinationWarehouseUuid, productId], map: "idx_stock_movements_destination_warehouse_product")
  @@index([productId], map: "idx_stock_movements_product")
  @@index([movementType], map: "idx_stock_movements_movement_type")
  @@index([referenceType, referenceUuid], map: "idx_stock_movements_reference_type_uuid")
  @@index([batchId], map: "idx_stock_movements_batch")
  @@map("stock_movements")
}

/// Mirrors 00_BUSINESS_RULES.md Ch.39.1's four named business event kinds exactly (05_CODING_STANDARDS.md Ch.26.4) — not a two-value direction flag, since Transfer is simultaneously inbound and outbound (STM-003).
enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT

  @@map("stock_movement_type")
}

// Batch (00_BUSINESS_RULES.md Ch.40: "a specific production or procurement
// grouping of a Product... typically sharing a common manufacture date,
// expiry date, or supplier lot number, tracked separately within overall
// Stock (Ch.38) for traceability and expiry-management purposes," Ch.40.1).
// Tenant-owned (`tenant_id`, MT-001), `companyUuid` a cross-module reference
// (FK-002, no DB-level FK) — the same MT-001 scoping every other table in
// this module already carries, not a Ch.40-specific invention (mirroring
// Stock Movement's own identical file-level reasoning). This milestone
// models ONLY the batch record itself, per Ch.40.4's own Scope ("batch-level
// sub-tracking of Stock... Out of scope: aggregate Stock quantity itself") —
// FEFO issue-selection logic (BAT-002), expiry-block enforcement (BAT-003),
// and the actual application of a Batch-tracked Stock Movement's quantity
// against this row's own `quantity` are all out of scope, deferred to later
// Repository/Business milestones, mirroring how Stock's own STK-001
// arithmetic was deferred at its own Database milestone.
//
// `productId` is a real, in-module RESTRICT FK (FK-001) to this module's own
// `products.id`, mirroring Stock's/Stock Movement's own `productId`
// treatment — Ch.40.10's ERD models this as `PRODUCT ||--o{ BATCH : "tracked
// in, if Batch-enabled"` (required, many-to-one).
//
// `warehouseUuid` is a cross-module reference (FK-002, no DB-level FK) to
// this module's own `warehouses.uuid`, mirroring Stock's/Inventory
// Adjustment's/Stock Movement's identical `warehouseUuid` treatment — Ch.40.3's
// own "Owns:" list explicitly names "the quantity of that specific batch
// held per Warehouse" as a fact this table owns, even though Ch.40.10's ERD
// diagram itself omits a literal BATCH-WAREHOUSE relationship line (the ERD
// only diagrams PRODUCT/BATCH and BATCH/STOCK_MOVEMENT) — modeled here
// because the "Owns:" prose is itself handbook text, not an invention beyond
// it.
//
// `batchNumber` (Ch.40.1/40.3: "batch number... supplier lot number") is a
// plain `VARCHAR(100)` — no handbook-specified length, a flagged
// undocumented-but-reasonable choice (wider than `productCode`'s/
// `warehouseCode`'s own `VARCHAR(32)`, since a supplier-assigned lot number
// is external, non-standardized text). No uniqueness constraint is placed on
// it — Ch.40 never states a Batch number must be unique (per Product, per
// Company, or otherwise), so none is invented; two different Batches with
// the same supplier lot number are permitted at the schema level.
//
// `manufactureDate`/`expiryDate` are both nullable `DateTime` columns —
// Ch.40.3 itself only marks expiry as conditional ("expiry date (if
// applicable)"), but neither field is described as ever mandatory ("NOT
// NULL") in literal handbook text, so neither is modeled as required.
// Ch.40.8's Validation Rule ("Expiry date, if provided, must be after the
// manufacture date") is a cross-column invariant, not a DB CHECK constraint
// per this milestone's own explicit instruction — deferred to the
// Business layer, mirroring every other cross-column invariant already
// deferred in this schema (STK-001, Unit.conversionFactor-required-only-
// when-baseUnitId-set).
//
// `quantity` is `DECIMAL(18,6)`, mirroring Stock's/Inventory Adjustment's/
// Stock Movement's own quantity columns exactly (fractional-quantity-safe) —
// no handbook-documented precision/scale exists for a batch quantity
// either, carrying forward the same already-flagged deviation those models
// established, not a newly invented one. Defaults to `0`, mirroring Stock's
// own quantity-columns-always-a-concrete-value reasoning.
//
// `status` (BatchStatus: ACTIVE/DEPLETED/EXPIRED/DISPOSED) models Ch.40.5's
// Business Lifecycle state diagram exactly (Active → Depleted via Issues
// reaching zero quantity; Active → Expired once the expiry date passes with
// quantity remaining; Expired → Disposed via a Ch.44 Inventory Adjustment
// write-off) — mirroring `ProductStatus`'s/`WarehouseStatus`'s own enum
// convention (05_CODING_STANDARDS.md Ch.26.4). Every transition
// (quantity-reaches-zero, expiry-date-passed, disposal) is a Business-layer
// computation/trigger, not modeled here.
//
// Back-relation `stockMovements StockMovement[]` supports BAT-001/Ch.40.10's
// own `BATCH ||--o{ STOCK_MOVEMENT` — `StockMovement.batchId` (added by this
// same milestone) is the real, in-module RESTRICT FK side of that
// relationship.
model Batch {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK, mirroring Stock's/Stock Movement's own `companyUuid` treatment.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Real, in-module RESTRICT FK to this module's own Product (Ch.34) — required, per Ch.40.10's ERD (`PRODUCT ||--o{ BATCH : "tracked in, if Batch-enabled"`).
  productId BigInt  @db.UnsignedBigInt @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Cross-module reference to this module's own `warehouses.uuid` (FK-002) — no DB-level FK, mirroring Stock's/Inventory Adjustment's/Stock Movement's identical `warehouseUuid` treatment. Required — Ch.40.3's own "Owns:" list names "the quantity of that specific batch held per Warehouse" as an always-present fact.
  warehouseUuid String @db.Char(36) @map("warehouse_uuid")

  /// Batch/lot identifier (00_BUSINESS_RULES.md Ch.40.1/40.3) — no uniqueness constraint (Ch.40 never states one is required).
  batchNumber String @db.VarChar(100) @map("batch_number")

  /// Manufacture date (Ch.40.3) — nullable; not described as mandatory in literal handbook text.
  manufactureDate DateTime? @db.DateTime(3) @map("manufacture_date")

  /// Expiry date (Ch.40.3: "if applicable") — nullable. Ch.40.8's "must be after the manufacture date" validation is a Business-layer concern, not a DB CHECK constraint.
  expiryDate DateTime? @db.DateTime(3) @map("expiry_date")

  /// Quantity of this specific Batch held at `warehouseUuid` (Ch.40.3) — DECIMAL(18,6), mirroring Stock's/Inventory Adjustment's/Stock Movement's own quantity columns exactly (fractional-quantity-safe).
  quantity Decimal @default(0) @db.Decimal(18, 6) @map("quantity")

  /// Batch lifecycle state (00_BUSINESS_RULES.md Ch.40.5): Active, Depleted, Expired, Disposed.
  status BatchStatus @default(ACTIVE) @map("status")

  /// Back-relation for Stock Movement's real, in-module RESTRICT FK (Ch.40.10/BAT-001) — this milestone's Database layer only, no repository/service reads this relation yet.
  stockMovements StockMovement[]

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@index([tenantId, companyUuid], map: "idx_batches_tenant_company")
  @@index([companyUuid, productId], map: "idx_batches_company_product")
  @@index([warehouseUuid, productId], map: "idx_batches_warehouse_product")
  @@index([productId], map: "idx_batches_product")
  @@index([batchNumber], map: "idx_batches_batch_number")
  @@index([status], map: "idx_batches_status")
  @@index([expiryDate], map: "idx_batches_expiry_date")
  @@map("batches")
}

/// Mirrors 00_BUSINESS_RULES.md Ch.40.5's Business Lifecycle state diagram exactly (05_CODING_STANDARDS.md Ch.26.4).
enum BatchStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  DISPOSED

  @@map("batch_status")
}

// Reorder Level (00_BUSINESS_RULES.md Ch.42: a configured minimum Stock,
// Ch.38, threshold per Product per Warehouse, below which a replenishment
// action is triggered or suggested). Tenant-owned (`tenant_id`, MT-001).
// Ch.42.5's own Business Lifecycle is "Static configuration, reviewed and
// adjusted periodically" — no state machine, so no enum is defined here
// (Ch.42 documents none).
//
// `companyUuid` and `warehouseUuid` are both cross-module references
// (FK-002, no DB-level FK), mirroring Stock's/Inventory Adjustment's own
// identical treatment of both fields exactly.
//
// `productId` is a real, in-module RESTRICT FK to this module's own
// `products.id` (FK-001) — mirroring Stock's/Inventory Adjustment's/Stock
// Movement's/Batch's own identical `productId` treatment exactly, since
// Product is owned by this same Inventory module. This requires the one
// Prisma-mandated back-relation list field on `Product` itself
// (`reorderLevels ReorderLevel[]`, added alongside this model) — pure
// relation metadata, not a database column (confirmed via `SHOW CREATE
// TABLE products`); no other change was made to `Product`. (Reconsidered
// from this model's first draft, which used a uuid-only `productUuid`
// cross-reference solely to sidestep this one Prisma-required
// back-relation line — on review, that was an unnecessary deviation from
// every other same-module Product reference in this file, not a genuine
// architectural conflict, so it has been corrected to match Stock's/
// Inventory Adjustment's/Stock Movement's/Batch's own established
// pattern.)
//
// ROL-101 ("A Reorder Level is defined per Product per Warehouse") is
// enforced here as "at most one (non-deleted) Reorder Level row per Product
// per Warehouse" via the unique constraint below (including `deletedAt`,
// SD-004, reusable after soft delete) — mirroring STK-003's own identical
// natural-key unique constraint on Stock.
//
// `reorderLevel` (the minimum threshold quantity) and `reorderQuantity`
// (the suggested reorder quantity, Ch.42.3's own "Owns:" list) are both
// `DECIMAL(18,6)`, mirroring Stock's/Inventory Adjustment's/Batch's own
// quantity-column precision/scale precedent exactly — no handbook-
// documented precision/scale exists for either field, so this is an
// explicitly flagged, undocumented-but-consistent choice, not a silently
// invented one. Neither has a default value — unlike Stock's own
// automatically-maintained, zero-starting quantities, a Reorder Level is a
// manually configured threshold with no natural zero-state default.
// Ch.42.8's validation rules ("must be a non-negative quantity"; the
// suggested reorder quantity "should be positive") are Business-layer
// concerns, not DB CHECK constraints, mirroring every other cross-column/
// numeric-range invariant deferred at every prior Database milestone in
// this file.
model ReorderLevel {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  uuid     String @unique @db.Char(36) @map("uuid")
  tenantId BigInt @db.UnsignedBigInt @map("tenant_id")

  /// Cross-module reference to Organization's `companies.uuid` (FK-002) — no DB-level FK.
  companyUuid String @db.Char(36) @map("company_uuid")

  /// Cross-module reference to this module's own `warehouses.uuid` (FK-002) — no DB-level FK, mirroring Stock's/Inventory Adjustment's own `warehouseUuid` treatment exactly.
  warehouseUuid String @db.Char(36) @map("warehouse_uuid")

  /// Real, in-module RESTRICT FK to this module's own Product (Ch.34) — required, ROL-101 ("A Reorder Level is defined per Product per Warehouse"), mirroring Stock's/Inventory Adjustment's/Batch's own `productId` treatment exactly.
  productId BigInt  @db.UnsignedBigInt @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Minimum threshold quantity (Ch.42.1/42.3) — DECIMAL(18,6), mirroring Stock's own quantity-column precedent (see file-level note above).
  reorderLevel Decimal @db.Decimal(18, 6) @map("reorder_level")

  /// Suggested reorder quantity (Ch.42.3) — DECIMAL(18,6), mirroring Stock's own quantity-column precedent (see file-level note above).
  reorderQuantity Decimal @db.Decimal(18, 6) @map("reorder_quantity")

  createdAt DateTime  @default(now()) @db.DateTime(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.DateTime(3) @map("updated_at")
  createdBy BigInt?   @db.UnsignedBigInt @map("created_by")
  updatedBy BigInt?   @db.UnsignedBigInt @map("updated_by")
  deletedAt DateTime? @db.DateTime(3) @map("deleted_at")

  @@unique([warehouseUuid, productId, deletedAt], map: "uq_reorder_levels_warehouse_product_deleted_at")
  @@index([tenantId, companyUuid], map: "idx_reorder_levels_tenant_company")
  @@index([companyUuid, warehouseUuid], map: "idx_reorder_levels_company_warehouse")
  @@index([warehouseUuid, productId], map: "idx_reorder_levels_warehouse_product")
  @@index([tenantId, companyUuid, warehouseUuid], map: "idx_reorder_levels_tenant_company_warehouse")
  @@map("reorder_levels")
}
