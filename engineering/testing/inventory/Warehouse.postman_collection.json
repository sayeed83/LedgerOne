              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventory/warehouses/{{warehouseUuid}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventory", "warehouses", "{{warehouseUuid}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"LiveTest Primary Warehouse {{warehouseSuffix}} (Revised)\",\n  \"description\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Revises name and explicitly clears description (null), leaving warehouseCode/status untouched (omitted, not null). branchUuid has no field here at all — immutable on Warehouse, not an updatable field (update-warehouse.dto.ts)."
          },
          "response": [],
