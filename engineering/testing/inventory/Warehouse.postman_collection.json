                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Name was revised and description cleared\", function () {",
                  "    pm.expect(json.data.name).to.eql(\"LiveTest Primary Warehouse \" + pm.collectionVariables.get(\"warehouseSuffix\") + \" (Revised)\");",
                  "    pm.expect(json.data.description).to.eql(null);",
                  "});",
                  "",
                  "pm.test(\"warehouseCode and branchUuid are unchanged\", function () {",
                  "    pm.expect(json.data.warehouseCode).to.eql(pm.collectionVariables.get(\"warehouseCode\"));",
                  "    pm.expect(json.data.branchUuid).to.eql(pm.collectionVariables.get(\"branchUuid\"));",
                  "});",
                  "pm.collectionVariables.set(\"warehouseName\", json.data.name);"
                ]
              }
            }
          ]
        },
