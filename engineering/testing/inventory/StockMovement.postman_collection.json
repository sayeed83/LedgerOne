              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "STM-003: RECEIPT requires destinationWarehouseUuid only (no sourceWarehouseUuid). Requires {{warehouseUuid}} and {{productId}} to be real fixtures (manual fixture gaps, see collection description). Saves {{movementUuid}}. STM-001 note: this also atomically increases the real Stock on-hand quantity for this Warehouse/Product pair \u2014 not verified by this collection (see the documented scope limitation in the collection description)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"movementUuid\", json.data.uuid);",
                  "",
                  "pm.test(\"Response exposes only business fields (never id/tenantId/createdBy/updatedBy/deletedAt), and no updatedAt at all (immutable)\", function () {",
                  "    pm.expect(json.data.id).to.be.undefined;",
                  "    pm.expect(json.data.tenantId).to.be.undefined;",
                  "    pm.expect(json.data.createdBy).to.be.undefined;",
                  "    pm.expect(json.data.updatedBy).to.be.undefined;",
                  "    pm.expect(json.data.deletedAt).to.be.undefined;",
                  "    pm.expect(json.data.updatedAt).to.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"RECEIPT shape: destinationWarehouseUuid set, sourceWarehouseUuid null\", function () {",
                  "    pm.expect(json.data.destinationWarehouseUuid).to.eql(pm.collectionVariables.get(\"warehouseUuid\"));",
                  "    pm.expect(json.data.sourceWarehouseUuid).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
