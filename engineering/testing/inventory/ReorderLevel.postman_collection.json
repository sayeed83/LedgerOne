                  "pm.test(\"reorderLevel and reorderQuantity round-trip\", function () {",
                  "    pm.expect(json.data.reorderLevel).to.eql(\"10\");",
                  "    pm.expect(json.data.reorderQuantity).to.eql(\"50\");",
                  "});"
                ]
              }
            }
