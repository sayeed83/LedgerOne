  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Computed once per Newman invocation (not per request) so every",
          "// request in this run shares the same fixture suffix, while two",
          "// separate runs never collide on names (no delete endpoint exists to",
          "// clean up between runs).",
          "if (!pm.collectionVariables.get(\"unitSuffix\")) {",
          "    pm.collectionVariables.set(\"unitSuffix\", String(Date.now()));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Response Content-Type is application/json\", function () {",
          "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
          "    if (!contentType.includes(\"application/json\")) {",
          "        return;",
          "    }",
          "    pm.response.to.have.header(\"Content-Type\");",
          "});",
          "",
          "pm.test(\"Response is either a {data} or {error} envelope, never both\", function () {",
          "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
          "    if (!contentType.includes(\"application/json\")) {",
          "        return;",
          "    }",
          "    const json = pm.response.json();",
          "    const hasData = Object.prototype.hasOwnProperty.call(json, \"data\");",
          "    const hasError = Object.prototype.hasOwnProperty.call(json, \"error\");",
          "    pm.expect(hasData !== hasError).to.eql(true);",
          "});"
        ]
      }
    }
  ],
