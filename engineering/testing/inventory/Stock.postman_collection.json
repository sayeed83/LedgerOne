          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"stockUuid\", json.data.uuid);",
                  "",
                  "pm.test(\"Response exposes only business fields (never id/tenantId/createdBy/updatedBy/deletedAt)\", function () {",
                  "    pm.expect(json.data.id).to.be.undefined;",
                  "    pm.expect(json.data.tenantId).to.be.undefined;",
                  "    pm.expect(json.data.createdBy).to.be.undefined;",
                  "    pm.expect(json.data.updatedBy).to.be.undefined;",
                  "    pm.expect(json.data.deletedAt).to.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"productId round-trips as a string\", function () {",
                  "    pm.expect(json.data.productId).to.eql(pm.collectionVariables.get(\"productId\"));",
                  "});",
                  "",
                  "pm.test(\"warehouseUuid matches the requested warehouse\", function () {",
                  "    pm.expect(json.data.warehouseUuid).to.eql(pm.collectionVariables.get(\"warehouseUuid\"));",
                  "});"
                ]
              }
            }
