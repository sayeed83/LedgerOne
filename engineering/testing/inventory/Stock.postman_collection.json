              "raw": "{\n  \"companyUuid\": \"{{companyUuid}}\",\n  \"warehouseUuid\": \"{{warehouseUuid}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantityOnHand\": \"100.0000\",\n  \"quantityReserved\": \"0.0000\",\n  \"quantityAvailable\": \"100.0000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Requires {{warehouseUuid}} to be a real Warehouse uuid (manual fixture, see collection description) and {{productId}} to be a real internal Product id (manual fixture \u2014 no HTTP endpoint exposes it, see collection description). Saves {{stockUuid}}."
