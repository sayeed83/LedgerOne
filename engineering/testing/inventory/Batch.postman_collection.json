              "mode": "raw",
              "raw": "{\n  \"companyUuid\": \"{{companyUuid}}\",\n  \"productId\": \"{{productId}}\",\n  \"warehouseUuid\": \"{{warehouseUuid}}\",\n  \"batchNumber\": \"BATCH-NO-DATES-001\",\n  \"quantity\": \"100\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "manufactureDate/expiryDate are both optional (Ch.40.3 never states either is mandatory) \u2014 this request omits both entirely, a distinct success case from the one below that sets both dates. Requires {{warehouseUuid}} to be a real Warehouse uuid and {{productId}} a real internal numeric Product id (see this collection's top-level description)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"batchNoDatesUuid\", json.data.uuid);",
                  "",
                  "pm.test(\"Response exposes only business fields (never id/tenantId/createdBy/updatedBy/deletedAt)\", function () {",
                  "    pm.expect(json.data.id).to.be.undefined;",
                  "    pm.expect(json.data.tenantId).to.be.undefined;",
                  "    pm.expect(json.data.createdBy).to.be.undefined;",
                  "    pm.expect(json.data.updatedBy).to.be.undefined;",
                  "    pm.expect(json.data.deletedAt).to.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"manufactureDate and expiryDate are both null\", function () {",
                  "    pm.expect(json.data.manufactureDate).to.eql(null);",
                  "    pm.expect(json.data.expiryDate).to.eql(null);",
                  "});",
                  "",
                  "pm.test(\"productId is serialized as a string\", function () {",
                  "    pm.expect(json.data.productId).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
