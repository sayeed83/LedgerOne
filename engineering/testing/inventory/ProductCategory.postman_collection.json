  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Computed once per Newman invocation (not per request) so every",
          "// request in this run shares the same fixture suffix, while two",
          "// separate runs never collide on Ch.35.8's per-hierarchy-level name",
          "// uniqueness rule (no delete endpoint exists to clean up between runs).",
          "if (!pm.collectionVariables.get(\"pcSuffix\")) {",
          "    pm.collectionVariables.set(\"pcSuffix\", String(Date.now()));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Response Content-Type is application/json\", function () {",
          "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
          "    if (!contentType.includes(\"application/json\")) {",
          "        // Express's own default 404 for a genuinely unmounted route",
          "        // (e.g. PUT/DELETE on a resource with no such endpoint) is a",
          "        // plain HTML page, not this module's JSON envelope — expected",
          "        // and intentional for the 'Historical Immutability' checks.",
          "        return;",
          "    }",
          "    pm.response.to.have.header(\"Content-Type\");",
          "});",
          "",
          "pm.test(\"Response is either a {data} or {error} envelope, never both\", function () {",
          "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
          "    if (!contentType.includes(\"application/json\")) {",
          "        return;",
          "    }",
          "    const json = pm.response.json();",
          "    const hasData = Object.prototype.hasOwnProperty.call(json, \"data\");",
          "    const hasError = Object.prototype.hasOwnProperty.call(json, \"error\");",
          "    pm.expect(hasData !== hasError).to.eql(true);",
          "});"
        ]
      }
    }
  ],
