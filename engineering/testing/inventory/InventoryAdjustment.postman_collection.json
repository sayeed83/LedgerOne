                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "inventory",
                "adjustments",
                "{{increaseAdjustmentUuid}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": \"25.0000\",\n  \"reason\": \"Physical count found extra stock (recount confirmed)\",\n  \"remarks\": \"Recounted twice by two different staff members\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Only quantity/reason/remarks are updatable (update-inventory-adjustment.dto.ts) \u2014 warehouseUuid/productId/adjustmentType are NOT accepted by this endpoint at all and cannot be changed after creation."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"quantity/reason/remarks were revised\", function () {",
                  "    pm.expect(json.data.quantity).to.eql(\"25.0000\");",
                  "    pm.expect(json.data.reason).to.eql(\"Physical count found extra stock (recount confirmed)\");",
                  "    pm.expect(json.data.remarks).to.eql(\"Recounted twice by two different staff members\");",
                  "});",
                  "",
                  "pm.test(\"adjustmentType/warehouseUuid/productId are unchanged (not updatable)\", function () {",
                  "    pm.expect(json.data.adjustmentType).to.eql(\"INCREASE\");",
                  "    pm.expect(json.data.warehouseUuid).to.eql(pm.collectionVariables.get(\"warehouseUuid\"));",
                  "    pm.expect(json.data.productId).to.eql(pm.collectionVariables.get(\"productId\"));",
                  "});"
