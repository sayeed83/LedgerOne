                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Error code is AUTH_PASSWORD_POLICY_VIOLATION\", function () {",
                  "    pm.expect(json.error.code).to.eql(\"AUTH_PASSWORD_POLICY_VIOLATION\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
