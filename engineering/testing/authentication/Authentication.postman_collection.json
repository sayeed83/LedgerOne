                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Reset Password - Policy Violation (Weak Password)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"token\": \"placeholder-token-never-looked-up\",\n  \"newPassword\": \"short\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            },
            "description": "Password shorter than 12 characters. This check runs BEFORE the token is looked up, so this returns AUTH_PASSWORD_POLICY_VIOLATION regardless of the token's validity — the token field here is a non-empty placeholder purely so it passes the schema's non-empty-string check and doesn't mask the assertion with VALIDATION_ERROR instead."
          },
          "event": [
            {
              "listen": "test",
