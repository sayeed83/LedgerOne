            },
            "description": "Registers a new User under the fixed {{tenantId}}/{{companyUuid}} test fixture (see collection description \u2014 no cross-module Organization dependency needed, since `users` carries no DB-level FK to `tenants`/`companies`, FK-002). Uses Postman's {{$randomEmail}} dynamic variable so repeated collection runs never collide on Ch.10.8's per-tenant email-uniqueness rule. Saves {{userUuid}} and {{userEmail}} for every subsequent request in this collection.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyUuid\": \"{{companyUuid}}\",\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"email\": \"{{$randomEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Response has data envelope\", function () {",
                  "    pm.expect(json).to.have.property(\"data\");",
                  "});",
                  "",
                  "pm.test(\"User has a uuid and Invited status\", function () {",
                  "    pm.expect(json.data.uuid).to.be.a(\"string\");",
                  "    pm.expect(json.data.status).to.eql(\"INVITED\");",
                  "});",
                  "",
                  "pm.test(\"Internal fields are never exposed\", function () {",
                  "    pm.expect(json.data.id).to.be.undefined;",
                  "    pm.expect(json.data.tenantId).to.be.undefined;",
                  "    pm.expect(json.data.createdBy).to.be.undefined;",
                  "    pm.expect(json.data.updatedBy).to.be.undefined;",
                  "    pm.expect(json.data.deletedAt).to.be.undefined;",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"userUuid\", json.data.uuid);",
                  "pm.collectionVariables.set(\"userEmail\", json.data.email);"
                ]
              }
            }
          ]
        },
